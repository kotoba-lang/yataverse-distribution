// Continue qualified legacy evidence with a separately signed buffered receiver, preserving incomplete trials.
'use strict';
const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),assert=require('node:assert/strict');
const {sha,json,durable,quote,verifyRoot}=require('./custody_common.cljk');
const [configFile,legacy,out]=process.argv.slice(2);if(!out||fs.existsSync(out))throw Error('new campaign output required');
const c=JSON.parse(fs.readFileSync(configFile));for(const s of [c.xavier,c.jacob])if(!/^[a-zA-Z0-9@._-]+$/.test(s.host)||!/^\/[a-zA-Z0-9/._-]+\/github\/workspaces\/codex\/yataverse-storage-persistent-20261011$/.test(s.root)||!/^\/[a-zA-Z0-9/._-]+$/.test(s.node))throw Error('dedicated endpoints required');
const codeSHA=sha(fs.readFileSync(__filename)),receiverSHA=sha(fs.readFileSync(path.join(__dirname,'custody_restore.cljk'))),steps=[],began=performance.now();fs.mkdirSync(out,{mode:0o700});
function state(phase,status,extra={}){const r={phase,status,time:new Date().toISOString(),wallMs:performance.now()-began,steps,...extra};fs.writeFileSync(path.join(out,'state.tmp'),json(r),{mode:0o600});fs.renameSync(path.join(out,'state.tmp'),path.join(out,'state.json'));console.log(JSON.stringify({phase,status,...extra}));}
const sh=(s,command)=>'ssh -o BatchMode=yes -o ConnectTimeout=10 '+quote(s.host)+' '+quote(command);
const node=(s,file,args)=>quote(s.node)+' --max-old-space-size=1024 '+quote(s.root+'/runtime-buffered-02/'+file)+' '+args.map(quote).join(' ');
const low=(s,command)=>s===c.xavier?'nice -n 19 ionice -c 3 '+command:'nice -n 19 /usr/sbin/taskpolicy -b '+command;
function readback(s,file,name){const r=cp.spawnSync('ssh',['-o','BatchMode=yes','-o','ConnectTimeout=10',s.host,'cat '+quote(s.root+'/'+file)],{maxBuffer:4*1024*1024});if(r.status!==0)throw Error('evidence read failed');durable(path.join(out,name),r.stdout);return JSON.parse(r.stdout);}
async function run(phase,command){state(phase,'running');const start=performance.now(),fd=fs.openSync(path.join(out,phase+'.log'),'wx',0o600);await new Promise((resolve,reject)=>{const p=cp.spawn('/bin/zsh',['-o','pipefail','-c',command],{stdio:['ignore',fd,fd]});p.on('error',reject);p.on('exit',code=>code===0?resolve():reject(Error(phase+' failed: '+code)));});fs.fsyncSync(fd);fs.closeSync(fd);steps.push({phase,wallMs:performance.now()-start,logSHA:sha(fs.readFileSync(path.join(out,phase+'.log')))});state(phase,'complete');}
function phase(label){for(const s of [c.xavier,c.jacob]){const r=cp.spawnSync('ssh',['-o','BatchMode=yes',s.host,'printf '+quote(label+'\n')+' > '+quote(s.root+'/phase.txt')]);if(r.status!==0)throw Error('phase label update');}}
(async()=>{state('qualify-source-transition','running');
 const oldState=JSON.parse(fs.readFileSync(path.join(legacy,'state.json')));if(oldState.status!=='failed')throw Error('legacy trial must be retired first');
 const build=JSON.parse(fs.readFileSync(path.join(legacy,'build.json'))),trust=JSON.parse(fs.readFileSync(path.join(legacy,'trust.json'))),initialRestore=JSON.parse(fs.readFileSync(path.join(legacy,'jacob-initial-restore.json'))),source={xavier:JSON.parse(fs.readFileSync(path.join(legacy,'xavier-source-audit.json'))),jacob:JSON.parse(fs.readFileSync(path.join(legacy,'jacob-source-audit.json')))};
 const xRestore=readback(c.xavier,'repair-from-jacob-01/restore-report.json','xavier-restore.json'),xAudit=readback(c.xavier,'repair-audit-01.json','xavier-repair-audit.json');
 for(const r of [initialRestore,xRestore])if(!r.complete||r.rootSHA!==trust.rootSHA||r.verifiedBlocks!==build.inventoryRows||r.verifiedBytes!==build.inventoryBytes||r.indexSupplied||r.sourceLakeRead)throw Error('legacy full restore qualification');
 for(const r of [...Object.values(source),xAudit])if(!r.verified||r.rootSHA!==trust.rootSHA||r.inventoryRows!==build.inventoryRows||r.inventoryBytes!==build.inventoryBytes)throw Error('legacy custody/readback qualification');
 const newTrust=readback(c.xavier,'trust-buffered-02.json','buffered-trust.json'),newAudit=readback(c.xavier,'source-audit-buffered-02.json','buffered-source-audit.json'),view=readback(c.xavier,'custody-buffered-02/source-view.json','source-view.json');
 const oldRoot=readback(c.xavier,'custody-01/control/2/root.json','legacy-root.json'),newRoot=readback(c.xavier,'custody-buffered-02/control/2/root.json','buffered-root.json'),oldBody=verifyRoot(json(oldRoot),trust),newBody=verifyRoot(json(newRoot),newTrust);
 assert.equal(trust.publicKey,newTrust.publicKey);for(const k of ['inventorySHA','inventoryRows','inventoryBytes','catalogSHA','indexSHA','packCount','keySHA','encryption'])assert.deepEqual(newBody[k],oldBody[k]);
 assert.equal(newBody.assets['custody_restore.cljk'],receiverSHA);for(const name of Object.keys(oldBody.assets))if(name!=='custody_restore.cljk')assert.equal(newBody.assets[name],oldBody.assets[name]);
 if(!newAudit.verified||newAudit.rootSHA!==newTrust.rootSHA||view.sourceRootSHA!==trust.rootSHA||view.physicalReplicaCreated||newAudit.inventoryRows!==build.inventoryRows||newAudit.inventoryBytes!==build.inventoryBytes)throw Error('new signed source qualification');
 const transition={oldRootSHA:trust.rootSHA,newRootSHA:newTrust.rootSHA,inventorySHA:newBody.inventorySHA,catalogSHA:newBody.catalogSHA,indexSHA:newBody.indexSHA,previousReceiverSHA:oldBody.assets['custody_restore.cljk'],bufferedReceiverSHA:receiverSHA,otherDecoderAssetsUnchanged:true,physicalReplicaCreated:false,newSourceAudit:newAudit,sourceView:view};durable(path.join(out,'software-transition.json'),json(transition));
 phase('buffered-trust-copy');await run('trust-to-jacob','scp -q '+quote(path.join(out,'buffered-trust.json'))+' '+quote(c.jacob.host+':'+c.jacob.root+'/trust-buffered-02.json'));
 phase('buffered-restore-from-xavier');await run('restore-from-xavier',sh(c.xavier,low(c.xavier,node(c.xavier,'custody_export.cljk',[c.xavier.root+'/custody-buffered-02',c.xavier.root+'/trust-buffered-02.json','degraded','16']))+' 2>'+quote(c.xavier.root+'/export-buffered-to-jacob-02.log'))+' | '+sh(c.jacob,low(c.jacob,node(c.jacob,'custody_restore.cljk',[c.jacob.root+'/trust-buffered-02.json',c.jacob.root+'/repair-from-xavier-buffered-02','raw']))));
 const jRestore=readback(c.jacob,'repair-from-xavier-buffered-02/restore-report.json','jacob-restore.json');if(!jRestore.complete||jRestore.rootSHA!==newTrust.rootSHA||jRestore.verifiedBlocks!==build.inventoryRows||jRestore.verifiedBytes!==build.inventoryBytes||jRestore.rawArchiveBytes!==build.inventoryBytes||jRestore.indexSupplied||jRestore.sourceLakeRead||jRestore.indexRebuiltSHA!==newBody.indexSHA||jRestore.rawArchiveSHA!==xRestore.rawArchiveSHA||jRestore.rawArchiveSHA!==initialRestore.rawArchiveSHA)throw Error('buffered full-byte coverage');
 phase('buffered-audit-jacob-repair');await run('audit-jacob-repair',sh(c.jacob,low(c.jacob,node(c.jacob,'custody_audit.cljk',[c.jacob.root+'/repair-from-xavier-buffered-02',c.jacob.root+'/trust-buffered-02.json',c.jacob.root+'/repair-audit-buffered-02.json']))));
 const jAudit=readback(c.jacob,'repair-audit-buffered-02.json','jacob-repair-audit.json');if(!jAudit.verified||jAudit.rootSHA!==newTrust.rootSHA||!jAudit.rawArchive?.independentReadback||!jAudit.rawArchive.offsetIndex?.verified||jAudit.rawArchive.bytes!==build.inventoryBytes||jAudit.rawArchive.verifiedCIDs!==build.inventoryRows||jAudit.rawArchive.sha256!==jRestore.rawArchiveSHA)throw Error('independent full archive/CID/offset readback');
 phase('post-baseline');await new Promise(r=>setTimeout(r,60000));await run('stop-telemetry',sh(c.xavier,'touch '+quote(c.xavier.root+'/stop-telemetry')));await run('stop-jacob-probes',sh(c.jacob,'touch '+quote(c.jacob.root+'/stop-probes')));await new Promise(r=>setTimeout(r,11000));
 for(const [s,remote,local] of [[c.xavier,'telemetry.jsonl','telemetry.jsonl'],[c.jacob,'service-probes.jsonl','jacob-service-probes.jsonl']])await run('fetch-'+local,'scp -q '+quote(s.host+':'+s.root+'/'+remote)+' '+quote(path.join(out,local)));
 const probes=fs.readFileSync(path.join(out,'jacob-service-probes.jsonl')),phases={};for(const r of probes.toString().trimEnd().split('\n').map(JSON.parse)){const p=phases[r.phase]??={samples:0,failures:0,latency:[]};p.samples++;if(r.ok)p.latency.push(r.latencyMs);else p.failures++;}for(const p of Object.values(phases)){p.meanLatencyMs=p.latency.length?p.latency.reduce((s,n)=>s+n,0)/p.latency.length:null;p.p95LatencyMs=p.latency.length?p.latency.toSorted((a,b)=>a-b)[Math.ceil(p.latency.length*.95)-1]:null;delete p.latency;}
 durable(path.join(out,'report.json'),json({schema:'yataverse-full-persistent-campaign/v2',complete:true,reports:{build,trust,initialRestore,source,restore:{xavier:xRestore,jacob:jRestore},repairAudit:{xavier:xAudit,jacob:jAudit}},softwareTransition:transition,legacyTrial:{completedCampaign:false,intentionallyRetired:true,incompleteRawFilesPreserved:true,state:oldState},steps,jacobServiceProbe:{sha256:sha(probes),phases,scope:'existing Kubo version API only; client scheduling/shared workloads included'},physicalWANShutdown:false,activeServiceConfigurationChanged:false,sourceServiceDataDeleted:false,keyScope:'study AES key recovery only; private signing-key recovery untested',externalProviderEquivalent:false,independentFaultDomainsQualified:false,codeSHA}));state('campaign','complete');
})().catch(e=>{state('campaign','failed',{error:e.message});process.exitCode=1;});
