// Cold receiver: no source lake, supplied index, lost-site key, or primary metadata is used.
'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto'),z=require('node:zlib');
const {sha,json,encode,recover,durable,syncDir,verifyRoot,savePack,unseal,cidDigest,indexEntry,totalFiles}=require('./custody_common.cljk');
const {TapeWriter}=require('./custody_tapes.cljk');
const [trustFile,out,rawMode='verify']=process.argv.slice(2);if(!trustFile||!out||fs.existsSync(out)||!['verify','raw'].includes(rawMode))throw Error('new restore output required');
const trust=JSON.parse(fs.readFileSync(trustFile)),queue=[],iter=process.stdin[Symbol.asyncIterator]();let queued=0,ended=false,wireBytes=0;
// Bound pending bytes and coalesce small regular-file writes; completion still requires fsync/readback.
function bufferedWriter(fd,limit){let chunks=[],bytes=0;const stats={bufferLimitBytes:limit,logicalWrites:0,systemWrites:0,bytes:0};
 function writeAll(b){for(let at=0;at<b.length;){const n=fs.writeSync(fd,b,at,b.length-at);if(n<=0)throw Error('regular-file write made no progress');at+=n;stats.systemWrites++;}}
 function flush(){if(!bytes)return;writeAll(chunks.length===1?chunks[0]:Buffer.concat(chunks,bytes));chunks=[];bytes=0;}
 return {stats,flush,write(value){const b=Buffer.isBuffer(value)?value:Buffer.from(value);stats.logicalWrites++;stats.bytes+=b.length;if(!bytes&&b.length>=limit){writeAll(b);return;}chunks.push(b);bytes+=b.length;if(bytes>=limit)flush();}};
}
async function read(n){while(queued<n){const r=await iter.next();if(r.done)throw Error('truncated WAN stream');queue.push(r.value);queued+=r.value.length;}const a=[];let remain=n;while(remain){const b=queue[0];if(b.length<=remain){a.push(queue.shift());remain-=b.length;queued-=b.length;}else{a.push(b.subarray(0,remain));queue[0]=b.subarray(remain);queued-=remain;remain=0;}}wireBytes+=n;return a.length===1?a[0]:Buffer.concat(a,n);}
async function frame(expected){const h=await read(8),ml=h.readUInt32BE(0),bl=h.readUInt32BE(4);if(ml<1||ml>1024||bl>256*1024*1024)throw Error('frame bounds');const m=JSON.parse((await read(ml)).toString());if(m.name!==expected||m.bytes!==bl)throw Error('frame identity');return read(bl);}
fs.mkdirSync(out,{recursive:true,mode:0o700});const began=performance.now();
(async()=>{const rb=await frame('root.json'),body=verifyRoot(rb,trust),cat=await frame('catalog.jsonl'),inv=await frame('inventory.jsonl'),key=await frame('data-key.bin');if(sha(cat)!==body.catalogSHA||sha(inv)!==body.inventorySHA||key.length!==32||sha(key)!==body.keySHA)throw Error('root/catalog/inventory/key trust');
 for(const name of ['custody_restore.cljk','custody_common.cljk','stream_codec.cljk','custody_tapes.cljk'])if(sha(fs.readFileSync(path.join(__dirname,name)))!==body.assets[name])throw Error('executing recovery software drift');
 const inventory=inv.toString().trimEnd().split('\n').map(JSON.parse),expected=new Map(inventory.map(r=>[r.cid,r.bytes]));if(expected.size!==body.inventoryRows||inventory.length!==body.inventoryRows||inventory.reduce((s,r)=>s+r.bytes,0)!==body.inventoryBytes)throw Error('inventory coverage');
 const assets={};for(const name of Object.keys(body.assets)){const b=await frame('asset/'+name);if(sha(b)!==body.assets[name])throw Error('software archive trust');assets[name]=b;}
 const catalog=cat.toString().trimEnd().split('\n').map(JSON.parse);if(catalog.length!==body.packCount||new Set(catalog.map(p=>p.id)).size!==body.packCount)throw Error('catalog coverage');
 const tapeWriter=process.platform==='darwin'?new TapeWriter(out,catalog,trust.rootSHA,body.catalogSHA):null;
 const indexfd=fs.openSync(path.join(out,'rebuilt-index.jsonl'),'wx',0o600),rawfd=rawMode==='raw'?fs.openSync(path.join(out,'restored-lake.bin'),'wx',0o600):null,rawIndexfd=rawMode==='raw'?fs.openSync(path.join(out,'restored-lake-index.jsonl'),'wx',0o600):null;
 const indexWriter=bufferedWriter(indexfd,256*1024),rawWriter=rawfd===null?null:bufferedWriter(rawfd,4*1024*1024),rawIndexWriter=rawIndexfd===null?null:bufferedWriter(rawIndexfd,256*1024);
 const ih=crypto.createHash('sha256'),rawHash=crypto.createHash('sha256'),seen=new Set();let current=null,hash=null,offset=0,rawOffset=0,verifiedBytes=0,decodeMs=0,repairMs=0;
 function finishCID(){if(current===null)return;if(offset!==expected.get(current)||hash.digest('hex')!==cidDigest(current).toString('hex'))throw Error('restored full CID mismatch');if(seen.has(current))throw Error('duplicate block');seen.add(current);}
 for(let pi=0;pi<catalog.length;pi++){const p=catalog[pi],mb=await frame(p.id+'/manifest.json');if(sha(mb)!==p.manifestSHA)throw Error('metadata trust');const m=JSON.parse(mb),shards=Array(6).fill(null);for(const i of [2,3,4,5])shards[i]=await frame(p.id+`/shard-${i}.bin`);
  const dt=performance.now(),sealed=recover(m,p.manifestSHA,shards),packed=unseal(sealed,key,body.inventorySHA+':'+p.id),raw=z.zstdDecompressSync(packed,{maxOutputLength:p.rawContainerBytes});if(sha(raw)!==p.rawSHA||raw.length!==p.rawContainerBytes||raw.subarray(0,8).toString()!=='YATAS02\n')throw Error('raw pack trust');const ml=raw.readUInt32BE(8);if(ml<1||ml>raw.length-12)throw Error('pack metadata bounds');const meta=JSON.parse(raw.subarray(12,12+ml));let at=12+ml;
  for(let ordinal=0;ordinal<meta.files.length;ordinal++){const w=meta.files[ordinal];if(expected.get(w.cid)!==w.blockBytes||!Number.isSafeInteger(w.offset)||!Number.isSafeInteger(w.bytes)||w.bytes<1||w.offset<0||w.offset+w.bytes>w.blockBytes||at+w.bytes>raw.length)throw Error('window bounds');if(w.cid!==current){finishCID();current=w.cid;hash=crypto.createHash('sha256');offset=0;}if(w.offset!==offset)throw Error('window gap/overlap');const b=raw.subarray(at,at+w.bytes);if(sha(b)!==w.sha256)throw Error('window SHA');hash.update(b);offset+=b.length;at+=b.length;verifiedBytes+=b.length;
   const line=Buffer.concat([json(indexEntry(w,p.id,ordinal)),Buffer.from('\n')]);indexWriter.write(line);ih.update(line);rawHash.update(b);if(rawfd!==null){rawWriter.write(b);rawIndexWriter.write(JSON.stringify({cid:w.cid,blockOffset:w.offset,archiveOffset:rawOffset,bytes:b.length})+'\n');rawOffset+=b.length;}}
  if(at!==raw.length)throw Error('pack trailing bytes');decodeMs+=performance.now()-dt;const rt=performance.now(),ec=encode(sealed);if(ec.manifestSHA!==p.manifestSHA)throw Error('regenerated metadata differs');if(tapeWriter)tapeWriter.write(p.id,ec);else savePack(out,p.id,ec);repairMs+=performance.now()-rt;
  const disk=fs.statfsSync(out);if(disk.bavail*disk.bsize<48*1024**3)throw Error('48GiB safety reserve');if(pi%100===99)console.log(JSON.stringify({stage:'restore',packs:pi+1,verifiedBytes,wireBytes,wallSeconds:(performance.now()-began)/1000}));
 }
 finishCID();const end=JSON.parse(await frame('end'));if(end.mode!=='degraded'||end.controlCopy!==2||!end.indexWithheld||end.packs!==catalog.length||seen.size!==body.inventoryRows||verifiedBytes!==body.inventoryBytes||ih.digest('hex')!==body.indexSHA)throw Error('final coverage/index mismatch');
 // Reject unexpected trailing frames, so an interrupted stream cannot appear complete.
 if(queued!==0||!(await iter.next()).done)throw Error('stream trailing bytes');
 const finalizeStart=performance.now();indexWriter.flush();rawWriter?.flush();rawIndexWriter?.flush();if(tapeWriter)tapeWriter.finish();fs.fsyncSync(indexfd);fs.closeSync(indexfd);if(rawfd!==null){fs.fsyncSync(rawfd);fs.closeSync(rawfd);fs.fsyncSync(rawIndexfd);fs.closeSync(rawIndexfd);}
 const control=path.join(out,'control');fs.mkdirSync(control,{mode:0o700});const index=fs.readFileSync(path.join(out,'rebuilt-index.jsonl'));for(const i of [0,2,4]){const d=path.join(control,String(i));fs.mkdirSync(d,{mode:0o700});for(const [name,b] of [['root.json',rb],['catalog.jsonl',cat],['inventory.jsonl',inv],['data-key.bin',key],['index.jsonl',index],...Object.entries(assets)])durable(path.join(d,name),b);syncDir(d);}syncDir(control);syncDir(out);
 const report={schema:'yataverse-full-wan-restore/v1',rootSHA:trust.rootSHA,inventorySHA:body.inventorySHA,verifiedBlocks:seen.size,verifiedBytes,packs:catalog.length,wireBytes,decodeMs,repairMs,finalizeMs:performance.now()-finalizeStart,storageBackend:tapeWriter?'shard-tapes':'pack-files',wallMs:performance.now()-began,indexRebuiltSHA:body.indexSHA,keyFromSurvivorBackup:true,metadataFromSurvivorBackup:true,indexSupplied:false,sourceLakeRead:false,rawArchiveBytes:rawOffset,rawArchiveSHA:rawHash.digest('hex'),writeBatching:{index:indexWriter.stats,raw:rawWriter?.stats??null,rawOffsetIndex:rawIndexWriter?.stats??null},repair:totalFiles(out),coldReceiver:true,fsync:true,complete:true,limits:'logical read exclusion, warm caches, dedicated study keys; source-site key compromise and annual durability not qualified'};durable(path.join(out,'restore-report.json'),json(report));console.log(JSON.stringify(report));
})().catch(e=>{console.error(e.message);process.exitCode=1;});
