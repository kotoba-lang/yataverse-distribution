// Native .js origin. Dedicated encrypted research custody, never production keys.
'use strict';
const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
const {sha,json,encode,recover}=require('./stream_codec.cljk');
const quote=s=>"'"+s.replaceAll("'","'\\''")+"'";
function durable(file,b,mode=0o600){const fd=fs.openSync(file,'wx',mode);try{fs.writeFileSync(fd,b);fs.fsyncSync(fd);}finally{fs.closeSync(fd);}syncDir(path.dirname(file));}
function syncDir(dir){const fd=fs.openSync(dir,'r');try{fs.fsyncSync(fd);}finally{fs.closeSync(fd);}}
function regular(file,max=256*1024*1024){const st=fs.lstatSync(file);if(!st.isFile()||st.size>max)throw Error('custody regular file/size');return fs.readFileSync(file);}
function seal(b,key,aad){if(key.length!==32)throw Error('key length');const iv=crypto.randomBytes(12),c=crypto.createCipheriv('aes-256-gcm',key,iv);c.setAAD(Buffer.from(aad));const body=Buffer.concat([c.update(b),c.final()]);return Buffer.concat([Buffer.from('YATENC01'),iv,c.getAuthTag(),body]);}
function unseal(b,key,aad){if(key.length!==32||b.length<36||b.subarray(0,8).toString()!=='YATENC01')throw Error('sealed format');const d=crypto.createDecipheriv('aes-256-gcm',key,b.subarray(8,20));d.setAAD(Buffer.from(aad));d.setAuthTag(b.subarray(20,36));return Buffer.concat([d.update(b.subarray(36)),d.final()]);}
function savePack(root,id,ec){if(!/^[ps]-\d{6}$/.test(id))throw Error('pack id');const d=path.join(root,'packs',id);fs.mkdirSync(d,{recursive:true,mode:0o700});ec.shards.forEach((b,i)=>durable(path.join(d,`shard-${i}.bin`),b));for(const i of [0,2,4]){durable(path.join(d,`manifest-${i}.json`),json(ec.manifest));durable(path.join(d,`receipt-${i}.json`),json(ec.receipt));}syncDir(path.dirname(d));}
function verifyRoot(b,trust){if(sha(b)!==trust.rootSHA)throw Error('root trust differs');const root=JSON.parse(b);if(root.schema!=='yataverse-persistent-root/v1'||root.publicKey!==trust.publicKey||!crypto.verify(null,json(root.body),root.publicKey,Buffer.from(root.signature,'base64')))throw Error('signed root invalid');return root.body;}
function signRoot(body,privateKey){const publicKey=crypto.createPublicKey(privateKey).export({type:'spki',format:'pem'});return {schema:'yataverse-persistent-root/v1',body,publicKey,signature:crypto.sign(null,json(body),privateKey).toString('base64')};}
function totalFiles(root){let files=0,bytes=0,allocated=0;for(const entry of fs.readdirSync(root,{withFileTypes:true})){const p=path.join(root,entry.name);if(entry.isDirectory()){const v=totalFiles(p);files+=v.files;bytes+=v.bytes;allocated+=v.allocatedBytes;}else{const s=fs.lstatSync(p);if(!s.isFile())throw Error('unexpected custody entry');files++;bytes+=s.size;allocated+=s.blocks*512;}}return {files,bytes,allocatedBytes:allocated};}
const b58='123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz',b32='abcdefghijklmnopqrstuvwxyz234567';
function cidDigest(cid){let bytes;if(/^Qm[1-9A-HJ-NP-Za-km-z]{44}$/.test(cid)){let n=0n;for(const c of cid)n=n*58n+BigInt(b58.indexOf(c));let h=n.toString(16);if(h.length%2)h='0'+h;bytes=Buffer.from(h,'hex');}else if(/^b[a-z2-7]{20,200}$/.test(cid)){let acc=0,bits=0,a=[];for(const c of cid.slice(1)){acc=(acc<<5)|b32.indexOf(c);bits+=5;if(bits>=8){bits-=8;a.push((acc>>>bits)&255);}}bytes=Buffer.from(a);let i=0;const vint=()=>{let n=0,s=0,b;do{if(i>=bytes.length||s>49)throw Error('varint');b=bytes[i++];n+=(b&127)*2**s;s+=7;}while(b&128);return n;};if(vint()!==1)throw Error('CID version');vint();bytes=bytes.subarray(i);}else throw Error('CID syntax');if(bytes.length!==34||bytes[0]!==18||bytes[1]!==32)throw Error('CID digest');return bytes.subarray(2);}
function indexEntry(p,id,ordinal){return {cid:p.cid,blockBytes:p.blockBytes,offset:p.offset,bytes:p.bytes,sha256:p.sha256,pack:id,ordinal};}
module.exports={sha,json,encode,recover,durable,syncDir,regular,seal,unseal,savePack,verifyRoot,signRoot,totalFiles,cidDigest,indexEntry,quote};
