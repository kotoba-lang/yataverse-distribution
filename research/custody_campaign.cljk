// Sequential isolated campaign. State/evidence stay local; failures preserve every partial directory.
'use strict';
const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process');
const {sha,json,durable,quote}=require('./custody_common.cljk');
const [configFile,out]=process.argv.slice(2);if(!configFile||!out||fs.existsSync(out))throw Error('new campaign state required');
const runtimeCodeSHA=sha(fs.readFileSync(__filename));
const c=JSON.parse(fs.readFileSync(configFile));for(const s of [c.xavier,c.jacob]){if(!/^[a-zA-Z0-9@._-]+$/.test(s.host)||!/^\/[a-zA-Z0-9/._-]+\/github\/workspaces\/codex\/yataverse-storage-persistent-20261011$/.test(s.root)||!/^\/[a-zA-Z0-9/._-]+$/.test(s.node))throw Error('dedicated research endpoints required');}
fs.mkdirSync(out,{recursive:true,mode:0o700});const log=fs.openSync(path.join(out,'events.jsonl'),'wx',0o600),began=performance.now(),steps=[];
const sh=(s,command)=>'ssh -o BatchMode=yes -o ConnectTimeout=10 '+quote(s.host)+' '+quote(command);
const node=(s,file,args)=>quote(s.node)+' --max-old-space-size=1024 '+quote(s.root+'/runtime/'+file)+' '+args.map(quote).join(' ');
const low=(s,command)=>s===c.xavier?'nice -n 19 ionice -c 3 '+command:'nice -n 19 '+command;
function state(phase,status,extra={}){const v={phase,status,time:new Date().toISOString(),wallMs:performance.now()-began,steps,...extra};fs.writeFileSync(path.join(out,'state.tmp'),json(v),{mode:0o600});fs.renameSync(path.join(out,'state.tmp'),path.join(out,'state.json'));fs.writeSync(log,json({phase,status,...extra}));fs.writeSync(log,'\n');fs.fsyncSync(log);console.log(JSON.stringify({phase,status,...extra}));}
async function run(phase,command){state(phase,'running');const start=performance.now(),fd=fs.openSync(path.join(out,phase+'.log'),'wx',0o600);await new Promise((resolve,reject)=>{const p=cp.spawn('/bin/zsh',['-o','pipefail','-c',command],{stdio:['ignore',fd,fd]});p.on('error',reject);p.on('exit',code=>code===0?resolve():reject(Error(phase+' failed: '+code)));});fs.fsyncSync(fd);fs.closeSync(fd);steps.push({phase,wallMs:performance.now()-start,logSHA:sha(fs.readFileSync(path.join(out,phase+'.log')))});state(phase,'complete');}
const phase=async label=>{for(const site of [c.xavier,c.jacob]){const r=cp.spawnSync('ssh',['-o','BatchMode=yes','-o','ConnectTimeout=10',site.host,'printf '+quote(label+'\n')+' > '+quote(site.root+'/phase.txt')]);if(r.status!==0)throw Error('telemetry phase update failed');}};
const readback=async(s,remoteName,localName)=>{const r=cp.spawnSync('ssh',['-o','BatchMode=yes','-o','ConnectTimeout=10',s.host,'cat '+quote(s.root+'/'+remoteName)],{maxBuffer:4*1024*1024});if(r.status!==0)throw Error('evidence read failed');durable(path.join(out,localName),r.stdout);return JSON.parse(r.stdout);};
(async()=>{state('wait-build','running');for(let n=0;;n++){const r=cp.spawnSync('ssh',['-o','BatchMode=yes','-o','ConnectTimeout=10',c.xavier.host,'test -f '+quote(c.xavier.root+'/custody-01/summary.json')],{timeout:20000});if(r.status===0)break;if(n>=240)throw Error('build wait exceeded four hours');await new Promise(r=>setTimeout(r,60000));}
 const build=await readback(c.xavier,'custody-01/summary.json','build.json');if(!build.fullByteCoverage)throw Error('source not complete');
 await phase('finalize');await run('finalize',sh(c.xavier,low(c.xavier,node(c.xavier,'custody_finalize.cljk',[c.xavier.root+'/custody-01',c.inventory,c.xavier.root+'/escrow/study-data-key.bin',c.xavier.root+'/escrow/study-signing-private.pem',c.xavier.root+'/trust-01.json']))));
 const trust=await readback(c.xavier,'trust-01.json','trust.json');const localTrust=path.join(out,'trust.json');await run('trust-to-jacob','scp -q '+quote(localTrust)+' '+quote(c.jacob.host+':'+c.jacob.root+'/trust-01.json'));
 await phase('source-audit');await run('xavier-source-audit',sh(c.xavier,low(c.xavier,node(c.xavier,'custody_audit.cljk',[c.xavier.root+'/custody-01',c.xavier.root+'/trust-01.json',c.xavier.root+'/source-audit-01.json']))));
 await phase('copy-to-jacob');await run('copy-to-jacob',sh(c.xavier,low(c.xavier,node(c.xavier,'custody_export.cljk',[c.xavier.root+'/custody-01',c.xavier.root+'/trust-01.json','degraded','16']))+' 2>'+quote(c.xavier.root+'/initial-export-to-jacob-01.log'))+' | '+sh(c.jacob,low(c.jacob,node(c.jacob,'custody_restore.cljk',[c.jacob.root+'/trust-01.json',c.jacob.root+'/custody-01','verify']))));
 const initialRestore=await readback(c.jacob,'custody-01/restore-report.json','jacob-initial-restore.json');if(!initialRestore.complete||initialRestore.verifiedBytes!==build.inventoryBytes||initialRestore.verifiedBlocks!==build.inventoryRows||initialRestore.rootSHA!==trust.rootSHA)throw Error('initial streaming replica incomplete');
 await phase('jacob-source-audit');await run('jacob-source-audit',sh(c.jacob,low(c.jacob,node(c.jacob,'custody_audit.cljk',[c.jacob.root+'/custody-01',c.jacob.root+'/trust-01.json',c.jacob.root+'/source-audit-01.json']))));
 const a=await readback(c.xavier,'source-audit-01.json','xavier-source-audit.json'),b=await readback(c.jacob,'source-audit-01.json','jacob-source-audit.json');if(!a.verified||!b.verified||a.rootSHA!==trust.rootSHA||b.rootSHA!==trust.rootSHA)throw Error('two-site custody proof failed');
 await phase('restore-from-jacob');await run('restore-from-jacob',sh(c.jacob,low(c.jacob,node(c.jacob,'custody_export.cljk',[c.jacob.root+'/custody-01',c.jacob.root+'/trust-01.json','degraded','16']))+' 2>'+quote(c.jacob.root+'/export-to-xavier-01.log'))+' | '+sh(c.xavier,low(c.xavier,node(c.xavier,'custody_restore.cljk',[c.xavier.root+'/trust-01.json',c.xavier.root+'/repair-from-jacob-01','verify']))));
 await phase('audit-xavier-repair');await run('audit-xavier-repair',sh(c.xavier,low(c.xavier,node(c.xavier,'custody_audit.cljk',[c.xavier.root+'/repair-from-jacob-01',c.xavier.root+'/trust-01.json',c.xavier.root+'/repair-audit-01.json']))));
 await phase('restore-from-xavier');await run('restore-from-xavier',sh(c.xavier,low(c.xavier,node(c.xavier,'custody_export.cljk',[c.xavier.root+'/custody-01',c.xavier.root+'/trust-01.json','degraded','16']))+' 2>'+quote(c.xavier.root+'/export-to-jacob-01.log'))+' | '+sh(c.jacob,low(c.jacob,node(c.jacob,'custody_restore.cljk',[c.jacob.root+'/trust-01.json',c.jacob.root+'/repair-from-xavier-01','raw']))));
 await phase('audit-jacob-repair');await run('audit-jacob-repair',sh(c.jacob,low(c.jacob,node(c.jacob,'custody_audit.cljk',[c.jacob.root+'/repair-from-xavier-01',c.jacob.root+'/trust-01.json',c.jacob.root+'/repair-audit-01.json']))));
 const reports={build,trust,initialRestore,source:{xavier:a,jacob:b},restore:{xavier:await readback(c.xavier,'repair-from-jacob-01/restore-report.json','xavier-restore.json'),jacob:await readback(c.jacob,'repair-from-xavier-01/restore-report.json','jacob-restore.json')},repairAudit:{xavier:await readback(c.xavier,'repair-audit-01.json','xavier-repair-audit.json'),jacob:await readback(c.jacob,'repair-audit-01.json','jacob-repair-audit.json')}};
 for(const r of Object.values(reports.restore))if(!r.complete||r.verifiedBytes!==build.inventoryBytes||r.verifiedBlocks!==build.inventoryRows||r.rootSHA!==trust.rootSHA)throw Error('full WAN coverage failed');for(const r of Object.values(reports.repairAudit))if(!r.verified||r.rootSHA!==trust.rootSHA)throw Error('repair readback failed');if(!reports.repairAudit.jacob.rawArchive?.independentReadback)throw Error('raw archive readback missing');
 await phase('post-baseline');await new Promise(r=>setTimeout(r,60000));await run('stop-telemetry',sh(c.xavier,'touch '+quote(c.xavier.root+'/stop-telemetry')));await run('stop-jacob-probes',sh(c.jacob,'touch '+quote(c.jacob.root+'/stop-probes')));await new Promise(r=>setTimeout(r,11000));await run('telemetry-to-local','scp -q '+quote(c.xavier.host+':'+c.xavier.root+'/telemetry.jsonl')+' '+quote(path.join(out,'telemetry.jsonl')));
 await run('jacob-probes-to-local','scp -q '+quote(c.jacob.host+':'+c.jacob.root+'/service-probes.jsonl')+' '+quote(path.join(out,'jacob-service-probes.jsonl')));
 const probes=fs.readFileSync(path.join(out,'jacob-service-probes.jsonl'));const observed=probes.toString().trimEnd().split('\n').map(JSON.parse),probePhases={};for(const r of observed){const p=probePhases[r.phase]??={samples:0,failures:0,latencyMs:[]};p.samples++;if(r.ok)p.latencyMs.push(r.latencyMs);else p.failures++;}for(const p of Object.values(probePhases)){p.meanLatencyMs=p.latencyMs.length?p.latencyMs.reduce((s,n)=>s+n,0)/p.latencyMs.length:null;p.p95LatencyMs=p.latencyMs.length?p.latencyMs.toSorted((a,b)=>a-b)[Math.ceil(p.latencyMs.length*.95)-1]:null;delete p.latencyMs;}
 durable(path.join(out,'report.json'),json({schema:'yataverse-full-persistent-campaign/v1',complete:true,reports,steps,jacobServiceProbe:{sha256:sha(probes),phases:probePhases,scope:'existing Kubo version API only'},physicalWANShutdown:false,activeServiceConfigurationChanged:false,sourceServiceDataDeleted:false,keyScope:'new study AES key and Ed25519 key only',externalProviderEquivalent:false,codeSHA:runtimeCodeSHA}));state('campaign','complete');fs.closeSync(log);
})().catch(e=>{state('campaign','failed',{error:e.message});fs.closeSync(log);process.exitCode=1;});
