// Compact HDD backend: six shard-position tapes and three metadata tapes.
// The same signed catalog and per-pack manifest hashes authenticate every range.
'use strict';
const fs=require('node:fs'),path=require('node:path');
const {sha,json,durable,syncDir,regular,totalFiles}=require('./custody_common.cljk');
const formatFile=root=>path.join(root,'storage-format.json');
function hasTapes(root){return fs.existsSync(formatFile(root));}
class TapeWriter{
 constructor(root,catalog,rootSHA,catalogSHA){this.root=root;this.catalog=catalog;this.rootSHA=rootSHA;this.catalogSHA=catalogSHA;this.count=0;this.dir=path.join(root,'tapes');fs.mkdirSync(this.dir,{mode:0o700});this.shards=[0,1,2,3,4,5].map(i=>fs.openSync(path.join(this.dir,`shard-${i}.bin`),'wx',0o600));this.meta=[0,2,4].map(i=>fs.openSync(path.join(this.dir,`metadata-${i}.jsonl`),'wx',0o600));}
 write(id,ec){const p=this.catalog[this.count];if(!p||p.id!==id||p.manifestSHA!==ec.manifestSHA||ec.manifest.width!==Math.ceil(p.zstdPayloadBytes/4)||ec.manifest.bytes!==p.zstdPayloadBytes)throw Error('tape catalog sequence');ec.shards.forEach((b,i)=>{if(b.length!==ec.manifest.width||sha(b)!==ec.manifest.shards[i])throw Error('tape shard trust');fs.writeSync(this.shards[i],b);});const line=Buffer.concat([json({id,manifest:ec.manifest,receipt:ec.receipt}),Buffer.from('\n')]);for(const fd of this.meta)fs.writeSync(fd,line);this.count++;}
 finish(){if(this.count!==this.catalog.length)throw Error('incomplete tapes');for(const fd of [...this.shards,...this.meta]){fs.fsyncSync(fd);fs.closeSync(fd);}syncDir(this.dir);syncDir(this.root);durable(formatFile(this.root),json({schema:'yataverse-custody-tapes/v1',rootSHA:this.rootSHA,catalogSHA:this.catalogSHA,packs:this.count,complete:true}));}
}
class TapeReader{
 constructor(root,catalog,rootSHA,catalogSHA,positions=[2,3,4,5],copy=2){const f=JSON.parse(regular(formatFile(root)));if(f.schema!=='yataverse-custody-tapes/v1'||!f.complete||f.rootSHA!==rootSHA||f.catalogSHA!==catalogSHA||f.packs!==catalog.length)throw Error('tape format trust');this.root=root;this.catalog=catalog;this.dir=path.join(root,'tapes');this.positions=positions;this.offsets=[];let offset=0;for(const p of catalog){this.offsets.push(offset);offset+=Math.ceil(p.zstdPayloadBytes/4);}this.total=offset;this.fds=new Map();for(const i of positions){const file=path.join(this.dir,`shard-${i}.bin`),st=fs.lstatSync(file);if(!st.isFile()||st.size!==offset)throw Error('tape size/type');this.fds.set(i,fs.openSync(file,'r'));}this.metadata=this.readMetadata(copy);}
 readMetadata(copy){if(![0,2,4].includes(copy))throw Error('metadata copy');const rows=regular(path.join(this.dir,`metadata-${copy}.jsonl`)).toString().trimEnd().split('\n').map(JSON.parse);if(rows.length!==this.catalog.length)throw Error('tape metadata coverage');rows.forEach((r,i)=>{const p=this.catalog[i],m=r.manifest;if(r.id!==p.id||sha(json(m))!==p.manifestSHA||m.width!==Math.ceil(p.zstdPayloadBytes/4)||m.bytes!==p.zstdPayloadBytes||json(r.receipt).toString()!==json({'manifest-sha256':p.manifestSHA,'payload-sha256':m.sha256}).toString())throw Error('tape metadata trust');});return rows;}
 shard(pack,i){if(!this.fds.has(i)||!this.catalog[pack])throw Error('withheld tape');const width=this.metadata[pack].manifest.width,b=Buffer.allocUnsafe(width);let at=0;while(at<width){const n=fs.readSync(this.fds.get(i),b,at,width-at,this.offsets[pack]+at);if(!n)throw Error('truncated tape');at+=n;}if(sha(b)!==this.metadata[pack].manifest.shards[i])throw Error('tape shard digest');return b;}
 close(sync=false){for(const fd of this.fds.values()){if(sync)fs.fsyncSync(fd);fs.closeSync(fd);}}
}
function consolidate(root,catalog,rootSHA,catalogSHA){const writer=new TapeWriter(root,catalog,rootSHA,catalogSHA);for(const p of catalog){if(!/^[ps]-\d{6}$/.test(p.id))throw Error('pack path');const d=path.join(root,'packs',p.id),m=JSON.parse(regular(path.join(d,'manifest-2.json')));if(sha(json(m))!==p.manifestSHA)throw Error('legacy manifest trust');const receipt={'manifest-sha256':p.manifestSHA,'payload-sha256':m.sha256};for(const i of [0,2,4])if(sha(regular(path.join(d,`manifest-${i}.json`)))!==p.manifestSHA||regular(path.join(d,`receipt-${i}.json`)).toString()!==json(receipt).toString())throw Error('legacy metadata trust');const shards=[0,1,2,3,4,5].map(i=>regular(path.join(d,`shard-${i}.bin`),48*1024*1024));writer.write(p.id,{manifest:m,manifestSHA:p.manifestSHA,receipt,shards});}writer.finish();return {converted:true,legacyFilesRetained:true};}
module.exports={hasTapes,TapeWriter,TapeReader,consolidate};
