// Independent persisted readback: every shard and all three control/metadata copies.
'use strict';
const fs=require('node:fs'),path=require('node:path');
const {sha,json,durable,regular:plainRead,verifyRoot,totalFiles,syncDir,cidDigest}=require('./custody_common.cljk');
const codeSHA=sha(fs.readFileSync(__filename));
function* offsetRows(file){const st=fs.lstatSync(file);if(!st.isFile())throw Error('offset index type');const fd=fs.openSync(file,'r'),b=Buffer.alloc(256*1024),hash=require('crypto').createHash('sha256');let pending='',rows=0;try{for(;;){const n=fs.readSync(fd,b,0,b.length,null);if(!n)break;hash.update(b.subarray(0,n));const lines=(pending+b.subarray(0,n).toString()).split('\n');pending=lines.pop();if(pending.length>65536)throw Error('offset index line bound');for(const line of lines){if(!line||line.length>65536)throw Error('offset index line');rows++;yield JSON.parse(line);}}if(pending)throw Error('offset index unterminated');fs.fsyncSync(fd);return {rows,sha256:hash.digest('hex'),verified:true,basis:'all mappings agree with signed canonical index'};}finally{fs.closeSync(fd);}}
function regular(file,max){const b=plainRead(file,max),fd=fs.openSync(file,'r');try{fs.fsyncSync(fd);}finally{fs.closeSync(fd);}return b;}
const {hasTapes,TapeReader,consolidate}=require('./custody_tapes.cljk');
const [root,trustFile,out]=process.argv.slice(2);if(!root||!out||fs.existsSync(out))throw Error('new audit required');
const trust=JSON.parse(regular(trustFile)),rb=regular(path.join(root,'control/2/root.json')),body=verifyRoot(rb,trust),cat=regular(path.join(root,'control/2/catalog.jsonl'));if(sha(cat)!==body.catalogSHA)throw Error('catalog trust');
let readBytes=0,shards=0;const began=performance.now();
for(const i of [0,2,4]){const d=path.join(root,'control',String(i));if(fs.statSync(path.join(d,'data-key.bin')).mode&0o077)throw Error('key custody permissions');for(const [name,hash] of [['root.json',trust.rootSHA],['catalog.jsonl',body.catalogSHA],['index.jsonl',body.indexSHA],['inventory.jsonl',body.inventorySHA],['data-key.bin',body.keySHA],...Object.entries(body.assets)]){const b=regular(path.join(d,name));if(sha(b)!==hash)throw Error('persisted control differs: '+name);readBytes+=b.length;}syncDir(d);}
const packs=cat.toString().trimEnd().split('\n').map(JSON.parse);let conversion=null;
if(process.platform==='darwin'&&!hasTapes(root))conversion=consolidate(root,packs,trust.rootSHA,body.catalogSHA);
const tapes=hasTapes(root)?new TapeReader(root,packs,trust.rootSHA,body.catalogSHA,[0,1,2,3,4,5],2):null;
if(tapes){for(const i of [0,2,4]){if(i!==2)tapes.readMetadata(i);const file=path.join(root,'tapes',`metadata-${i}.jsonl`);readBytes+=regular(file).length;}for(let pno=0;pno<packs.length;pno++){for(let i=0;i<6;i++){const b=tapes.shard(pno,i);readBytes+=b.length;shards++;}if(pno%250===249)console.log(JSON.stringify({stage:'audit',packs:pno+1,readBytes,wallSeconds:(performance.now()-began)/1000}));}tapes.close(true);syncDir(path.join(root,'tapes'));}
else for(let pno=0;pno<packs.length;pno++){const p=packs[pno],dir=path.join(root,'packs',p.id),mb=regular(path.join(dir,'manifest-2.json')),m=JSON.parse(mb);if(sha(mb)!==p.manifestSHA)throw Error('manifest trust');for(const i of [0,2,4]){const b=regular(path.join(dir,`manifest-${i}.json`)),r=regular(path.join(dir,`receipt-${i}.json`));if(sha(b)!==p.manifestSHA||r.toString()!==json({'manifest-sha256':p.manifestSHA,'payload-sha256':m.sha256}).toString())throw Error('metadata readback differs');readBytes+=b.length+r.length;}
 for(let i=0;i<6;i++){const b=regular(path.join(dir,`shard-${i}.bin`),48*1024*1024);if(b.length!==m.width||sha(b)!==m.shards[i])throw Error('shard readback differs');readBytes+=b.length;shards++;}syncDir(dir);if(pno%250===249)console.log(JSON.stringify({stage:'audit',packs:pno+1,readBytes,wallSeconds:(performance.now()-began)/1000}));}
let archive=null;const rawFile=path.join(root,'restored-lake.bin');if(fs.existsSync(rawFile)){const st=fs.lstatSync(rawFile);if(!st.isFile()||st.size!==body.inventoryBytes)throw Error('raw archive size/type');const index=regular(path.join(root,'control/2/index.jsonl'));if(sha(index)!==body.indexSHA)throw Error('raw archive index trust');const mappings=offsetRows(path.join(root,'restored-lake-index.jsonl'));const fd=fs.openSync(rawFile,'r'),buffer=Buffer.alloc(4*1024*1024),all=require('crypto').createHash('sha256'),seen=new Set();let current=null,hash=null,offset=0,blockBytes=0,bytes=0;
 const finish=()=>{if(current===null)return;if(offset!==blockBytes||hash.digest('hex')!==cidDigest(current).toString('hex')||seen.has(current))throw Error('archive CID mismatch');seen.add(current);};
 try{for(const line of index.toString().trimEnd().split('\n')){const w=JSON.parse(line),next=mappings.next(),m=next.value;if(next.done||Object.keys(m).length!==4||m.cid!==w.cid||m.blockOffset!==w.offset||m.archiveOffset!==bytes||m.bytes!==w.bytes)throw Error('archive offset index differs');if(w.bytes>buffer.length||w.bytes<1)throw Error('archive window bound');if(w.cid!==current){finish();current=w.cid;hash=require('crypto').createHash('sha256');offset=0;blockBytes=w.blockBytes;}if(w.offset!==offset)throw Error('archive gap');let at=0;while(at<w.bytes){const n=fs.readSync(fd,buffer,at,w.bytes-at,null);if(!n)throw Error('archive truncated');at+=n;}const b=buffer.subarray(0,w.bytes);if(sha(b)!==w.sha256)throw Error('archive window SHA');hash.update(b);all.update(b);offset+=b.length;bytes+=b.length;}finish();if(bytes!==body.inventoryBytes||seen.size!==body.inventoryRows)throw Error('archive full coverage');const mappingEnd=mappings.next();if(!mappingEnd.done)throw Error('archive offset index trailing rows');fs.fsyncSync(fd);archive={bytes,verifiedCIDs:seen.size,sha256:all.digest('hex'),trustedIndexSHA:body.indexSHA,offsetIndex:mappingEnd.value,independentReadback:true};}finally{mappings.return();fs.closeSync(fd);}}
syncDir(path.join(root,tapes?'tapes':'packs'));syncDir(path.join(root,'control'));syncDir(root);
const controlAllocation=totalFiles(path.join(root,'control')),packAllocation=totalFiles(path.join(root,tapes?'tapes':'packs')),custodyAllocation=Object.fromEntries(['files','bytes','allocatedBytes'].map(k=>[k,controlAllocation[k]+packAllocation[k]]));
if(tapes){const marker=fs.statSync(path.join(root,'storage-format.json'));custodyAllocation.files++;custodyAllocation.bytes+=marker.size;custodyAllocation.allocatedBytes+=marker.blocks*512;}
const stat=fs.statfsSync(root),r={schema:'yataverse-persistent-readback/v1',codeSHA,rootSHA:trust.rootSHA,inventoryBytes:body.inventoryBytes,inventoryRows:body.inventoryRows,packs:packs.length,shards,allControlCopies:3,allMetadataCopies:3,readBytes,rawArchive:archive,wallMs:performance.now()-began,storageBackend:tapes?'shard-tapes':'pack-files',conversion,allocation:totalFiles(root),custodyAllocation,controlAllocation,filesystem:{capacityBytes:stat.blocks*stat.bsize,availableBytes:stat.bavail*stat.bsize},verified:true,coldProcess:true,fsync:true,limits:'filesystem file allocation excludes directories/journal/reserves; readback has no power-cut/cache eviction; no service files changed'};durable(out,json(r));console.log(JSON.stringify(r));
