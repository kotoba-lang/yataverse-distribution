// Full-campaign accounting: supplied prices + measured rails + explicit sensitivity, never invented invoices.
'use strict';
const fs=require('node:fs'),{sha,json,durable}=require('./custody_common.cljk');
const [campaignFile,telemetryFile,inputsFile,out]=process.argv.slice(2);if(!out||fs.existsSync(out))throw Error('new TCO report');
const campaign=JSON.parse(fs.readFileSync(campaignFile)),inputs=JSON.parse(fs.readFileSync(inputsFile));if(!campaign.complete)throw Error('completed campaign required');
for(const k of ['xavierPurchaseJPY','jacobPurchaseJPY','electricityJPYPerKWh'])if(!Number.isFinite(inputs[k])||inputs[k]<0)throw Error('user cost inputs');
const telemetryBytes=fs.readFileSync(telemetryFile),rows=telemetryBytes.toString().trimEnd().split('\n').map(JSON.parse),phases={};
for(let i=0;i<rows.length;i++){const r=rows[i],p=phases[r.phase]??={samples:0,kuboFailures:0,kuboLatencyMs:[],railWatts:[],integratedRailWh:0,integratedSeconds:0};p.samples++;if(!r.kuboVersionOK)p.kuboFailures++;else p.kuboLatencyMs.push(r.kuboVersionLatencyMs);const watts=Object.values(r.railWatts).every(Number.isFinite)?Object.values(r.railWatts).reduce((a,b)=>a+b,0):null;if(watts!==null)p.railWatts.push(watts);
 if(i+1<rows.length){const next=rows[i+1],seconds=next.monotonic-r.monotonic,nw=Object.values(next.railWatts).every(Number.isFinite)?Object.values(next.railWatts).reduce((a,b)=>a+b,0):null;if(seconds>0&&seconds<=30&&watts!==null&&nw!==null){p.integratedRailWh+=(watts+nw)/2*seconds/3600;p.integratedSeconds+=seconds;}}}
const mean=a=>a.length?a.reduce((s,v)=>s+v,0)/a.length:null,percentile=(a,p)=>a.length?a.toSorted((a,b)=>a-b)[Math.min(a.length-1,Math.ceil(a.length*p)-1)]:null;
const telemetry=Object.fromEntries(Object.entries(phases).map(([name,p])=>[name,{samples:p.samples,kuboFailures:p.kuboFailures,kuboMeanLatencyMs:mean(p.kuboLatencyMs),kuboP95LatencyMs:percentile(p.kuboLatencyMs,.95),meanRailWatts:mean(p.railWatts),integratedRailWh:p.integratedRailWh,integratedSeconds:p.integratedSeconds,railElectricityJPY:p.integratedRailWh/1000*inputs.electricityJPYPerKWh}]));
const capacity=campaign.reports.source,sealedGB=campaign.reports.build.totals.zstdPayloadBytes/1e9,singleControlSetBytes=capacity.xavier.controlAllocation.bytes/3,packedGB=sealedGB+singleControlSetBytes/1e9,physicalGB=(capacity.xavier.custodyAllocation.bytes+capacity.jacob.custodyAllocation.bytes)/1e9,allocatedGB=(capacity.xavier.custodyAllocation.allocatedBytes+capacity.jacob.custodyAllocation.allocatedBytes)/1e9;
if(capacity.xavier.controlAllocation.bytes!==capacity.jacob.controlAllocation.bytes)throw Error('control sets differ');
const totalCapitalJPY=inputs.xavierPurchaseJPY+inputs.jacobPurchaseJPY,hoursMonth=730,maintenanceJPYHour=3000,fxSensitivity=[100,150,200];
const scenarios=[];for(const depreciationMonths of [36,60])for(const combinedMainsWatts of [20,40,60])for(const maintenanceHoursMonth of [0,.5,2]){const amortizationJPYMonth=totalCapitalJPY/depreciationMonths,electricityJPYMonth=combinedMainsWatts/1000*hoursMonth*inputs.electricityJPYPerKWh,maintenanceJPYMonth=maintenanceHoursMonth*maintenanceJPYHour;scenarios.push({allocation:'both whole hosts dedicated',depreciationMonths,combinedMainsWatts,maintenanceHoursMonth,maintenanceJPYHour,amortizationJPYMonth,electricityJPYMonth,maintenanceJPYMonth,subtotalJPYMonth:amortizationJPYMonth+electricityJPYMonth+maintenanceJPYMonth,totalJPYMonth:null,assumedNotMeasured:true});}
const provider=[{name:'R2 Standard',monthlyCapacityUSD:packedGB*.015,source:'https://developers.cloudflare.com/r2/pricing/'},{name:'B2',monthlyCapacityUSD:packedGB*.00695,source:'https://www.backblaze.com/cloud-storage/pricing'},{name:'Filecoin / Fil One dedicated service',monthlyCapacityUSD:Math.max(5.99,packedGB/1000*5.99),source:'https://www.fil.one/'}].map(r=>({...r,JPYAtAssumedFX:fxSensitivity.map(jpyPerUSD=>({jpyPerUSD,monthlyCapacityJPY:r.monthlyCapacityUSD*jpyPerUSD})),totalUSD:null,actualPUTGETMeasured:false,guaranteeMatched:false}));
// Shared-capacity accounting is a policy assumption, not incremental cash flow or a metered resource attribution.
const diskCapacityBytes={xavier:capacity.xavier.filesystem.capacityBytes,jacob:capacity.jacob.filesystem.capacityBytes};
const sharedScenarios=[36,60].map(months=>({allocation:'host capital proportional to measured custody bytes / filesystem capacity; assumes hardware purchase covers that capacity',depreciationMonths:months,capitalJPYMonth:inputs.xavierPurchaseJPY/months*capacity.xavier.custodyAllocation.bytes/diskCapacityBytes.xavier+inputs.jacobPurchaseJPY/months*capacity.jacob.custodyAllocation.bytes/diskCapacityBytes.jacob,electricityJPYMonth:null,maintenanceJPYMonth:null,totalJPYMonth:null,assumedNotMeasured:true,externalDrivePurchaseUnpriced:true}));
const retainedTestAllocatedGB=Object.values(capacity).reduce((s,r)=>s+r.allocation.allocatedBytes,0)/1e9+Object.values(campaign.reports.repairAudit).reduce((s,r)=>s+r.allocation.allocatedBytes,0)/1e9;
const report={schema:'yataverse-electricity-capital-maintenance/v1',completeRecoveryMeasured:true,inventoryBytes:campaign.reports.build.inventoryBytes,packedSealedGB:sealedGB,providerBillableGB:packedGB,singleControlSetBytes,twoSiteFileBytesGB:physicalGB,twoSiteAllocatedGB:allocatedGB,retainedTestAllocatedGB,diskCapacityBytes,userInputs:inputs,totalSuppliedCapitalJPY:totalCapitalJPY,telemetrySHA:sha(telemetryBytes),telemetry,wholeHostScenarios:scenarios,sharedCapacityScenarios:sharedScenarios,provider,
 faultDomains:inputs.faultDomains??null,independentFaultDomainsQualified:false,providerEquivalentDurabilityQualified:false,
 retainedTestAllocationScope:'four qualified custody/repair roots only; excludes original lake, same-node source views, preserved incomplete trials, earlier smoke fixtures, local LLM model/runtime and controller files; whole-study inode-deduplicated census reported separately',
 actualTotalJPYMonth:null,unknown:['Jacob mains power and external-drive power','Xavier adapter and carrier/disk mains losses','depreciation lifetime and allocation policy','maintenance labor rate/hours','additional disk purchase/replacement/reserve capacity','filesystem directory/inode/journal and reserve-space overhead','network subscription and actual recurring retrieval/repair rate','controller/SSH relay host power and capital allocation','research engineering labor and model/API costs','monitoring/scrub/key-custody operations and equivalent durability qualification'],
 assumptions:{hoursMonth,maintenanceJPYHour,controllerSSHRelayUsed:true,allocation:'regular-file bytes and stat blocks only; not total filesystem management space',FX:'100/150/200 JPY per USD sensitivity only, not fetched exchange rates',zeroMaintenance:'optimistic floor only, not evidence of zero ongoing work'},limits:'rail samples include existing services; not study-attributable or whole-host AC energy; scenario subtotals exclude unresolved costs, so actual TCO remains unknown; prices are capacity estimates, not provider invoices'};
durable(out,json(report));console.log(JSON.stringify({twoSiteAllocatedGB:allocatedGB,totalSuppliedCapitalJPY:totalCapitalJPY,wholeHostMonthlySubtotalRangeJPY:[Math.min(...scenarios.map(r=>r.subtotalJPYMonth)),Math.max(...scenarios.map(r=>r.subtotalJPYMonth))],actualTotalJPYMonth:null}));
