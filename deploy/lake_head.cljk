;; deploy/lake_head.cljk — the yataverse lake log on inga (ADR-2610062000 P2).
;;
;; Lake membership is a chain of CID-addressed manifests. The head is the inga
;; ref `yataverse/lake`; each seq names one manifest CID. This file reads that
;; head the only way that does not trust the host it is read from: every
;; witness's answer is checked with inga.commitment (the record is in the
;; block, the block hash is the one the certificate names, and the certificate
;; carries a quorum of signatures from the PINNED public keys), and a head is
;; believed only when `--min` witnesses prove the same (seq, cid).
;;
;; Run from a score-witness release (it carries inga, inga-node and their
;; pinned deps):
;;   node <release>/engine/cli.js \
;;     --classpath "<release>/inga/src:<release>/inga-node/src:<release>/storage/src:<release>/text/src:<release>/edn/src:<release>/bytes/src" \
;;     deploy/lake_head.cljk verify <score-witness-v5.edn> [--min=5]
;;   ... deploy/lake_head.cljk submit <score-witness-v5.edn> <seq> <manifest-cid> [--min=5]
;;
;; Exit: 0 verified / submitted-and-verified; 1 refused (REFUSE line names the
;; reason, e.g. a different CID already holds that seq); 3 could not reach a
;; verdict (too few witnesses answered with a valid proof).

(ns lake-head
  (:require [clojure.string :as str]
            [kotoba.lang.edn :as edn]
            [inga.consensus :as c]
            [inga.commitment :as commitment]
            [inga-node.seams :as seams]))

(def fs (js/require "node:fs"))
(def nc (js/require "node:crypto"))

;; ── writer signatures (opt-in; kotoba-lang/inga#22 inga.writer) ─────────────
;;
;; `--writer-seed=FILE` signs each submitted record: FILE holds a 32-byte
;; Ed25519 seed as hex and never leaves the host. `--writer-policy=FILE` makes
;; verify, bundle and verify-bundle refuse a head whose writer the policy does
;; not allow, the way an inga-node running INGA_WRITER_POLICY refuses it.
;; Without either flag nothing changes.
;;
;; These are local copies of inga.writer/signing-text and refusal, because a
;; score-witness release does not carry inga#22 yet. A record also carries no
;; "prev" (signed as empty): inga.commitment normalises a record to
;; ref/seq/cid/prev/height, and today's readers select only ref/seq/cid, so a
;; prev in the record would stop them verifying it. writer and sig are extra
;; fields, which commitment ignores.

(defn- argv-flag [k]
  (some #(when (str/starts-with? % (str k "=")) (subs % (inc (count k))))
        (array-seq (aget js/process "argv"))))

(def ^:private b58 "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz")

(defn- b58-encode [buf]
  (let [bytes (vec (array-seq buf))
        digits (reduce (fn [ds byte]
                         (loop [i 0 carry byte out []]
                           (if (< i (count ds))
                             (let [x (+ (* (nth ds i) 256) carry)]
                               (recur (inc i) (quot x 58) (conj out (rem x 58))))
                             (loop [carry carry out out]
                               (if (pos? carry) (recur (quot carry 58) (conj out (rem carry 58))) out)))))
                       [] bytes)]
    (str (apply str (repeat (count (take-while zero? bytes)) "1"))
         (apply str (map #(nth b58 %) (reverse digits))))))

(defn- b58-decode [text]
  (let [idx (map #(.indexOf b58 %) text)]
    (when (every? #(>= % 0) idx)
      (let [bytes (reduce (fn [bs d]
                            (loop [i 0 carry d out []]
                              (if (< i (count bs))
                                (let [x (+ (* (nth bs i) 58) carry)]
                                  (recur (inc i) (quot x 256) (conj out (rem x 256))))
                                (loop [carry carry out out]
                                  (if (pos? carry) (recur (quot carry 256) (conj out (rem carry 256))) out)))))
                          [] idx)]
        (js/Buffer.from (clj->js (concat (repeat (count (take-while #(= % 0) idx)) 0) (reverse bytes))))))))

(defn- spki [pub] (.createPublicKey nc #js {:key (js/Buffer.concat #js [(js/Buffer.from #js [0x30 0x2a 0x30 0x05 0x06 0x03 0x2b 0x65 0x70 0x03 0x21 0x00]) pub])
                                            :format "der" :type "spki"}))
(defn- pkcs8 [seed] (.createPrivateKey nc #js {:key (js/Buffer.concat #js [(js/Buffer.from #js [0x30 0x2e 0x02 0x01 0x00 0x30 0x05 0x06 0x03 0x2b 0x65 0x70 0x04 0x22 0x04 0x20]) seed])
                                               :format "der" :type "pkcs8"}))

(defn writer-signing-text
  "Byte-identical to inga.writer/signing-text."
  [r]
  (str "inga/ref-record/v1\n" (get r "ref") "\n" (get r "seq") "\n" (get r "cid") "\n" (or (get r "prev") "")))

(defn did-key->pub [did]
  (when (and (string? did) (str/starts-with? did "did:key:z"))
    (when-let [raw (b58-decode (subs did 9))]
      (when (and (= 34 (.-length raw)) (= 0xed (aget raw 0)) (= 1 (aget raw 1))) (.subarray raw 2)))))

(defn writer-of-seed
  "-> {:did :sign}. The seed stays in this process."
  [seed-hex]
  (let [sk (pkcs8 (js/Buffer.from seed-hex "hex"))
        pub (-> (.createPublicKey nc sk) (.export #js {:format "der" :type "spki"}) (.subarray 12))]
    {:did (str "did:key:z" (b58-encode (js/Buffer.concat #js [(js/Buffer.from #js [0xed 0x01]) pub])))
     :sign (fn [text] (.toString (.sign nc nil (js/Buffer.from text "utf8") sk) "base64"))}))

(defn writer-refusal
  "Same rule as inga.writer/refusal, with Ed25519 did:key verification."
  [policy r]
  (let [allowed (or (get policy (get r "ref"))
                    (some->> (keys policy)
                             (filter #(and (str/ends-with? % "/") (str/starts-with? (get r "ref") %)))
                             (sort-by count >) first (get policy)))]
    (when allowed
      (let [w (get r "writer") sig (get r "sig")]
        (cond
          (not (and (string? w) (string? sig))) :unsigned
          (not (contains? allowed w)) :writer-not-allowed
          (not (try (when-let [pub (did-key->pub w)]
                      (.verify nc nil (js/Buffer.from (writer-signing-text r) "utf8") (spki pub) (js/Buffer.from sig "base64")))
                    (catch :default _ false)))
          :bad-signature
          :else nil)))))

(def writer
  (when-let [f (argv-flag "--writer-seed")]
    (writer-of-seed (str/trim (.readFileSync fs f "utf8")))))

(def writer-policy
  (when-let [f (argv-flag "--writer-policy")]
    (let [p (edn/read-string (.readFileSync fs f "utf8"))]
      (if (and (map? p) (every? string? (keys p)) (every? #(and (set? %) (every? string? %)) (vals p)))
        p
        (do (println "REFUSE --writer-policy is not {string #{did:key}}:" f) (js/process.exit 1))))))
;; `--ref=` selects the inga ref. Default is the lake log; P4 graph-head mirrors
;; use yataverse/graph/<graph-cid> (graph_head_mirror.py). Anything else is
;; refused so a typo cannot open a new ref by accident.
(def ref-name
  (let [r (or (some #(when (str/starts-with? % "--ref=") (subs % 6))
                    (array-seq (aget js/process "argv")))
              "yataverse/lake")]
    (if (re-matches #"yataverse/(lake|graph/baf[a-z2-7]{50,})" r)
      r
      (do (println "REFUSE --ref must be yataverse/lake or yataverse/graph/<cid>:" r)
          (js/process.exit 1)))))

(defn- out [& xs] (println (str/join " " xs)))
(defn- exit! [code] (js/process.exit code))

(defn ledger [path]
  (let [l (edn/read-string (.readFileSync fs path "utf8"))
        ids (mapv :id (:witnesses l))]
    (when-not (and (= 7 (count ids)) (= (set ids) (set (keys (:pubkeys l)))))
      (out "REFUSE ledger lacks a full pinned key set:" path)
      (exit! 1))
    l))

(defn context [l]
  (let [ids (mapv :id (:witnesses l))]
    {:chain-id (:chain-id l)
     :hash-fn seams/hash-fn
     :quorum (c/quorum-size (count ids))
     :verify-fn (seams/verify-fn (:pubkeys l))
     :admitted? (set ids)
     :decode-proposal (fn [s] (try (js->clj (js/JSON.parse s)) (catch :default _ nil)))}))

(defn- fetch-json [url opts]
  (-> (js/fetch url (clj->js (merge {:signal (js/AbortSignal.timeout 8000)} opts)))
      (.then (fn [r] (if (.-ok r) (.json r) nil)))
      (.catch (fn [_] nil))))

(defn- witness-url [w] (str "http://" (:ip w) ":" (:port w)))

(defn- check-one
  "One witness's head, verified, as {:id :seq :cid} — or {:id :refused reason}."
  [ctx w]
  (-> (fetch-json (str (witness-url w) "/committed?ref=" (js/encodeURIComponent ref-name)) {})
      (.then
       (fn [body]
         (let [head (some-> body (aget "head") js->clj)
               proof (some-> body (aget "proof") edn/read-string)]
           (cond
             (nil? body) {:id (:id w) :refused :unreachable}
             (nil? head) {:id (:id w) :refused :no-head}
             (not (and (map? proof) (:block proof) (:qc proof))) {:id (:id w) :refused :no-proof}
             :else
             (let [record (select-keys head ["ref" "seq" "cid"])
                   reason (commitment/verify-commitment
                           {:record record :block (:block proof) :qc (:qc proof)} ctx)]
               (if-let [why (or reason (when writer-policy (writer-refusal writer-policy head)))]
                 {:id (:id w) :refused why}
                 {:id (:id w) :seq (get head "seq") :cid (get head "cid")
                  :head (select-keys head ["ref" "seq" "cid" "writer" "sig"])
                  :proof-text (aget body "proof")}))))))))

(defn verdict
  "Pure. results from check-one. -> {:status :verified|:split|:unmeasured ...}"
  [results min-agree]
  (let [ok (remove :refused results)
        groups (group-by (juxt :seq :cid) ok)
        [[seq cid] members] (last (sort-by (comp count val) groups))]
    (cond
      (and members (>= (count members) min-agree))
      {:status :verified :seq seq :cid cid :witnesses (sort (map :id members))}
      (> (count groups) 1) {:status :split :groups (into {} (map (fn [[k v]] [k (map :id v)]) groups))}
      ;; Reachable witnesses that hold no record for the ref. Only a quorum of
      ;; them counts, and it is not proof of absence (a lagging witness also
      ;; answers :no-head); it only tells a new ref to start at seq 0, where a
      ;; conflicting holder is still refused by submit.
      (and (empty? ok) (>= (count (filter #(= :no-head (:refused %)) results)) min-agree))
      {:status :absent}
      :else {:status :unmeasured :verified (count ok)})))

(defn verify! [l min-agree]
  (let [ctx (context l)]
    (-> (js/Promise.all (clj->js (map #(check-one ctx %) (:witnesses l))))
        (.then (fn [rs] (let [rs (vec (array-seq rs))] [rs (verdict rs min-agree)]))))))

(defn- report [[rs v]]
  (let [detail (str/join "," (map #(str (:id %) "=" (or (some-> (:refused %) name) (str (:seq %) ":" (subs (:cid %) 0 14)))) rs))]
    (case (:status v)
      :verified (out "VERIFIED" ref-name "seq" (:seq v) "cid" (:cid v) "by" (count (:witnesses v)) "witnesses" detail)
      :split (out "REFUSE witnesses disagree" (pr-str (:groups v)) detail)
      :absent (out "ABSENT" ref-name "no witness holds a record" detail)
      (out "UNMEASURED only" (:verified v) "witnesses proved a head" detail))
    v))

(defn- submit-once [l seq' cid i]
  (let [w (nth (:witnesses l) (mod i (count (:witnesses l))))]
    (fetch-json (str (witness-url w) "/submit")
                {:method "POST" :headers {"content-type" "application/json"}
                 :body (js/JSON.stringify
                        (clj->js {:record (let [r {"ref" ref-name "seq" seq' "cid" cid}]
                                            (if writer
                                              (assoc r "writer" (:did writer) "sig" ((:sign writer) (writer-signing-text r)))
                                              r))}))})))

(defn submit!
  "Submit and keep resubmitting (rotating witnesses) until the head at `seq'`
  is verified. A submission can be accepted into a mempool and still never be
  committed (observed 2026-10-06: the first epoch-0 submit vanished), so
  `submitted: true` is not an outcome."
  [l seq' cid min-agree]
  (letfn [(attempt [i]
            (if (> i 12)
              (do (out "UNMEASURED gave up after" i "submissions") (exit! 3))
              (-> (submit-once l seq' cid i)
                  (.then (fn [_] (js/Promise. (fn [res] (js/setTimeout res 20000)))))
                  (.then (fn [_] (verify! l min-agree)))
                  (.then (fn [[rs v]]
                           (cond
                             (and (= :verified (:status v)) (= seq' (:seq v)) (= cid (:cid v)))
                             (do (report [rs v]) (exit! 0))
                             (and (= :verified (:status v)) (>= (:seq v) seq') (not= cid (:cid v))
                                  (= seq' (:seq v)))
                             (do (out "REFUSE seq" seq' "is held by" (:cid v)) (exit! 1))
                             (and (= :verified (:status v)) (> (:seq v) seq'))
                             (do (out "REFUSE head already at seq" (:seq v)) (exit! 1))
                             :else (attempt (inc i))))))))]
    (attempt 0)))

;; ── bundle: a proof anyone can check without the tailnet ────────────────────
;;
;; The witnesses listen on tailnet addresses only. A bundle carries the head
;; and every proof that verified when it was made, so a reader with the pinned
;; keys (score-witness-v5.edn) can check it offline, however it was fetched --
;; IPFS, onion, a file on a USB stick. What it proves: this (seq, cid) was
;; committed by a quorum. What it does NOT prove: that no higher seq exists. A
;; stale bundle verifies; freshness needs a live witness or a newer bundle.

(defn bundle! [l min-agree out-path]
  (-> (verify! l min-agree)
      (.then
       (fn [[rs v]]
         (when-not (= :verified (:status v)) (report [rs v]) (exit! 3))
         (let [members (filter #(and (= (:seq v) (:seq %)) (= (:cid v) (:cid %))) rs)
               b {"schema" "yataverse-lake-proof-bundle/v1"
                  "ref" ref-name "chain-id" (:chain-id l)
                  ;; writer/sig ride along when the head was signed, so a
                  ;; reader with --writer-policy can check the bundle offline.
                  "head" (merge {"ref" ref-name "seq" (:seq v) "cid" (:cid v)}
                                (select-keys (:head (first members)) ["writer" "sig"]))
                  "proofs" (vec (for [m members] {"witness" (:id m) "proof" (:proof-text m)}))}]
           (.writeFileSync fs out-path (js/JSON.stringify (clj->js b)))
           (out "BUNDLED" ref-name "seq" (:seq v) "cid" (:cid v) "proofs" (count members) "out" out-path)
           (exit! 0))))))

(defn verify-bundle! [l min-agree path]
  (let [b (js->clj (js/JSON.parse (.readFileSync fs path "utf8")))
        head (get b "head")
        ctx (context l)
        results (for [p (get b "proofs")]
                  (let [proof (try (edn/read-string (get p "proof")) (catch :default _ nil))]
                    (if-not (and (map? proof) (:block proof) (:qc proof))
                      [(get p "witness") :malformed]
                      [(get p "witness")
                       (or (commitment/verify-commitment
                            {:record (select-keys head ["ref" "seq" "cid"])
                             :block (:block proof) :qc (:qc proof)} ctx)
                           :ok)])))
        ok (count (filter #(= :ok (second %)) results))
        detail (str/join "," (map #(str (first %) "=" (name (second %))) results))]
    (cond
      (not (and (= ref-name (get head "ref")) (= (:chain-id l) (get b "chain-id"))))
      (do (out "REFUSE bundle is for" (get head "ref") "on" (get b "chain-id")) (exit! 1))
      (and writer-policy (writer-refusal writer-policy head))
      (do (out "REFUSE bundle head writer:" (name (writer-refusal writer-policy head))) (exit! 1))
      (>= ok min-agree)
      (do (out "VERIFIED-BUNDLE" ref-name "seq" (get head "seq") "cid" (get head "cid")
               "proofs-ok" ok "(committed by quorum; not a proof that no higher seq exists)" detail)
          (exit! 0))
      :else (do (out "REFUSE only" ok "proofs verify" detail) (exit! 1)))))

;; ── resolve: membership from the log, not from a dated file ────────────────

(def crypto (js/require "node:crypto"))

(defn- ipfs-cat [rpc cid]
  ;; Kubo RPC is POST-only. A local node verifies blocks against their CIDs as
  ;; it reads them; the sha256 below is the manifest's own claim, checked too.
  (-> (js/fetch (str rpc "/api/v0/cat?arg=" cid)
                #js {:method "POST" :signal (js/AbortSignal.timeout 120000)})
      (.then (fn [r] (if (.-ok r) (.arrayBuffer r)
                         (throw (js/Error. (str "ipfs cat " cid " HTTP " (.-status r)))))))
      (.then (fn [ab] (js/Buffer.from ab)))))

(defn- sha256-hex [buf] (-> (.createHash crypto "sha256") (.update buf) (.digest "hex")))

(defn resolve!
  "Verify the head, then walk prev links to epoch 0. Every manifest must
  carry epoch == its seq and the prev CID the walk arrived from; every
  inventory must match its manifest's sha256 and row count. Writes the
  inventories concatenated in epoch order to `out`."
  [l min-agree rpc out-path]
  (-> (verify! l min-agree)
      (.then
       (fn [[rs v]]
         (when-not (= :verified (:status v)) (report [rs v]) (exit! 3))
         (letfn [(walk [seq' cid acc]
                   (-> (ipfs-cat rpc cid)
                       (.then
                        (fn [buf]
                          (let [m (js->clj (js/JSON.parse (.toString buf "utf8")))
                                inv (get m "inventory")]
                            (when-not (and (= "yataverse-lake-manifest/v1" (get m "schema"))
                                           (= seq' (get m "epoch")))
                              (out "REFUSE manifest" cid "is not epoch" seq') (exit! 1))
                            (when (and (pos? seq') (nil? (get m "prev")))
                              (out "REFUSE manifest" cid "has no prev at epoch" seq') (exit! 1))
                            (-> (ipfs-cat rpc (get inv "cid"))
                                (.then
                                 (fn [ibuf]
                                   (let [rows (count (filter seq (str/split (.toString ibuf "utf8") #"\n")))]
                                     (when-not (and (= (get inv "sha256") (sha256-hex ibuf))
                                                    (= (get inv "rows") rows))
                                       (out "REFUSE inventory" (get inv "cid") "differs from manifest" cid)
                                       (exit! 1))
                                     (let [acc (conj acc {:epoch seq' :buf ibuf :rows rows :bytes (get inv "bytes")})]
                                       (if (zero? seq')
                                         acc
                                         (walk (dec seq') (get m "prev") acc))))))))))))]
           (walk (:seq v) (:cid v) []))))
      (.then
       (fn [acc]
         (let [ordered (sort-by :epoch acc)
               joined (js/Buffer.concat (clj->js (map :buf ordered)))]
           (.writeFileSync fs out-path joined)
           (out "RESOLVED" ref-name "epochs" (count ordered)
                "rows" (reduce + (map :rows ordered))
                "bytes" (reduce + (map :bytes ordered))
                "sha256" (sha256-hex joined) "out" out-path)
           (exit! 0))))
      (.catch (fn [e] (out "UNMEASURED" (.-message e)) (exit! 3)))))

(let [argv (vec (array-seq (aget js/process "argv")))
      args (vec (rest (drop-while #(not (str/ends-with? % "lake_head.cljk")) argv)))
      flag (fn [k d] (or (some #(when (str/starts-with? % (str k "="))
                                  (js/parseInt (subs % (inc (count k))) 10)) args) d))
      pos (vec (remove #(str/starts-with? % "--") args))
      [cmd ledger-path a b] pos
      min-agree (flag "--min" 5)]
  (case cmd
    "verify" (-> (verify! (ledger ledger-path) min-agree)
                 (.then report)
                 (.then (fn [v] (exit! (case (:status v) :verified 0 :split 1 :absent 4 3)))))
    "bundle" (let [sflag (fn [k] (some #(when (str/starts-with? % (str k "=")) (subs % (inc (count k)))) args))]
               (bundle! (ledger ledger-path) min-agree
                        (or (sflag "--out") (do (out "REFUSE bundle needs --out=FILE") (exit! 1)))))
    "verify-bundle" (verify-bundle! (ledger ledger-path) min-agree a)
    "resolve" (let [sflag (fn [k] (some #(when (str/starts-with? % (str k "=")) (subs % (inc (count k)))) args))]
                (resolve! (ledger ledger-path) min-agree
                          (or (sflag "--rpc") "http://127.0.0.1:5001")
                          (or (sflag "--out") (do (out "REFUSE resolve needs --out=FILE") (exit! 1)))))
    "submit" (let [seq' (js/parseInt a 10)]
               (when-not (and (nat-int? seq') (string? b) (re-matches #"baf[a-z2-7]{50,}" b))
                 (out "REFUSE usage: submit <ledger> <seq> <manifest-cid>") (exit! 1))
               (submit! (ledger ledger-path) seq' b min-agree))
    "writer-did" (if writer (do (out (:did writer)) (exit! 0)) (do (out "REFUSE writer-did needs --writer-seed=FILE") (exit! 1)))
    (do (out "REFUSE usage: verify <ledger> | submit <ledger> <seq> <cid>  [--ref=yataverse/graph/<cid>] [--writer-seed=FILE] [--writer-policy=FILE]") (exit! 1))))
