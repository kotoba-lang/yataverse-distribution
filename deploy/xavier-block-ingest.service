[Unit]
Description=block-ingest on xavier: signed, CID-checked block writes into the fleet Kubo (no R2; kotoba)
After=network-online.target ipfs.service
Wants=ipfs.service

[Service]
Type=simple
WorkingDirectory=/home/xavier/.local/share/block-ingest
# --allow lists the did:key of every Worker that may write. Each signer's
# blocks are held under /block-ingest/<its did:key>/ in Kubo's MFS.
ExecStart=/usr/local/bin/node /home/xavier/.local/share/yataverse-writer/release/engine/cli.js --classpath /home/xavier/.local/share/block-ingest/bin /home/xavier/.local/share/block-ingest/bin/block_ingest.cljk --host=0.0.0.0 --port=18140 \
  --allow=did:key:z6Mkr2JXYtHYmcH84SPxZCQnBCLXGSgcMhc9AAJhpBXnJnFY \
  --ipfs-bin=/mnt/nvme/ipfs-xavier/bin/ipfs --ipfs-path=/mnt/nvme/ipfs-xavier/repo \
  --max-block-bytes=16777216 --max-concurrent-puts=4 --rate=20 --burst=40 --state-dir=/home/xavier/.local/share/block-ingest/state
StandardOutput=append:/home/xavier/.local/share/block-ingest/logs/block-ingest.out.log
StandardError=append:/home/xavier/.local/share/block-ingest/logs/block-ingest.err.log
Restart=on-failure
RestartSec=10
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=default.target
