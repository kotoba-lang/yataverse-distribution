[Unit]
Description=Open main-2's yataverse-writer over libp2p at 127.0.0.1:18131 (nginx backup; no tailnet)
After=ipfs.service
Wants=ipfs.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/xavier/.local/share/yataverse-writer/bin/p2p_mount.py --ipfs "env IPFS_PATH=/mnt/nvme/ipfs-xavier/repo /mnt/nvme/ipfs-xavier/bin/ipfs" --forward-to 12D3KooWREkjSRXrLFe6HXzaP9LpRBGNfJV7YuEwLw5tK2VQH9hN --listen /ip4/127.0.0.1/tcp/18131 --loop 30
StandardOutput=append:/home/xavier/.local/share/yataverse-writer/logs/p2p-forward-main2.out.log
StandardError=append:/home/xavier/.local/share/yataverse-writer/logs/p2p-forward-main2.err.log
Restart=on-failure
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
