;; deploy/block_ingest.cljk — signed, content-checked block writes into the
;; fleet's own Kubo, for Workers that stop using R2 (owner direction
;; 2026-10-07; com-junkawasaki/root ADR-2610071530).
;;
;; Until now nothing outside the fleet could put a block on a fleet Kubo: the
;; only public writer is yataverse-writer (16 KB graph heads) and kotobase.net's
;; PUT /ipfs/:cid stores into Backblaze B2. This service is that missing
;; write path, and nothing more:
;;
;;   PUT    /v1/blocks/<cid>   body = the block's bytes          signed
;;     201 {"cid", "size", "held"}  stored and held (200 when it already was)
;;     400 bad CID / bytes do not hash to the CID   401/403 signature   413 too large
;;   DELETE /v1/blocks/<cid>                                       signed
;;     200 {"released"}  the signer's hold on the block is gone   404 not held by this signer
;;   GET    /v1/blocks/<cid>   the bytes, read offline and checked against the CID   404
;;   GET    /health
;;
;; CIDs are CIDv1 sha2-256 (base32 "b...") with codec raw (0x55) or dag-cbor
;; (0x71): the address IS the hash, so a writer cannot store bytes under
;; someone else's name, and a reader checks what it gets. The hash is checked
;; for every codec; the codec itself is the writer's claim (Kubo does not
;; validate dag-cbor either), and readers that decode the block check it.
;; dag-cbor is accepted so that Merkle-LSM nodes (kotobase-peer manifests,
;; catalog directories, runs) live on the fleet instead of R2
;; (ADR-2610092150).
;;
;; Holds, not pins. A held raw block is an MFS entry /block-ingest/<signer>/<cid>,
;; which keeps it from Kubo's GC. DELETE removes only that entry, so a signer
;; can release what it stored and nothing else: the lake's pins, other
;; signers' holds and the writer's documents are untouched.
;;
;; MFS takes only UnixFS (dag-pb or raw) -- Kubo 0.41 answers "cp: source must
;; be a valid UnixFS" for dag-cbor -- so a dag-cbor hold is a direct pin plus
;; the signer's entry in <state-dir>/holds/<signer>.json. The pin is removed
;; only when the last signer that holds the block releases it.
;;
;; Signature. Every PUT and DELETE carries
;;   x-kotoba-signer:    did:key (Ed25519) on --allow
;;   x-kotoba-time:      unix seconds, within --max-skew of now
;;   x-kotoba-signature: base64url Ed25519 over
;;                       "kotoba/block-ingest/v1\n" METHOD "\n" cid "\n" time
;; The body is not signed: it is bound by the CID. A replayed PUT stores the
;; same bytes again (idempotent); a replayed DELETE inside the skew window
;; releases a block the signer already released.
;;
;; usage (node <release>/engine/cli.js --classpath deploy deploy/block_ingest.cljk ...):
;;   --allow=did:key:... ... --ipfs-bin=PATH --ipfs-path=DIR
;;   [--host=127.0.0.1] [--port=18140] [--max-block-bytes=16777216]
;;   [--max-skew=300] [--max-concurrent-puts=4] [--rate=20] [--burst=40] [--state-dir=DIR (heads)]
;;
;; Exposure (2026-10-07): xavier has no root for nginx, so the service listens
;; on 0.0.0.0:18140 and the router forwards that port (UPnP, xavier user; see
;; xavier-block-ingest-upnp.*). Plain HTTP is enough for this protocol: writes
;; are signed and bound to their CID, reads are checked against the CID, and
;; murakumo encrypts every part before it is written.

(ns block-ingest
  (:require [clojure.string :as str]
            [graph-head :as g]))

(def http (js/require "node:http"))
(def cp (js/require "node:child_process"))
(def nc (js/require "node:crypto"))

(def domain-tag "kotoba/block-ingest/v1\n")
(def raw-cid-re
  "Shape of an accepted CID string: CIDv1, one-byte codec, sha2-256, base32.
   Shape only -- `parse-cid` decides whether the codec is accepted."
  #"b[a-z2-7]{58}")

(def codecs {0x55 "raw" 0x71 "dag-cbor"})

(def ^:private b32-alphabet "abcdefghijklmnopqrstuvwxyz234567")

(defn- b32-decode [s]
  (loop [[c & more] (seq s) bits 0 v 0 out []]
    (if-not c
      out
      (let [i (.indexOf b32-alphabet c)
            v (bit-or (bit-shift-left (bit-and v 0xff) 5) i)
            bits (+ bits 5)]
        (if (>= bits 8)
          (recur more (- bits 8) v (conj out (bit-and (unsigned-bit-shift-right v (- bits 8)) 0xff)))
          (recur more bits v out))))))

(defn parse-cid
  "{:codec \"raw\"|\"dag-cbor\" :digest Buffer} for an accepted CID string, else nil."
  [s]
  (when (and (string? s) (re-matches raw-cid-re s))
    (let [bs (b32-decode (subs s 1))
          codec (get codecs (nth bs 1 nil))]
      (when (and (= 36 (count bs)) (= 1 (nth bs 0)) codec
                 (= 0x12 (nth bs 2)) (= 0x20 (nth bs 3)))
        {:codec codec :digest (js/Buffer.from (clj->js (subvec bs 4)))}))))

(defn cid-of
  "CIDv1 base32 for `buf` under `codec` (\"raw\" or \"dag-cbor\")."
  [codec buf]
  (let [code (some (fn [[k v]] (when (= v codec) k)) codecs)
        digest (-> (.createHash nc "sha256") (.update buf) (.digest))]
    (str "b" (g/b32-encode (js/Buffer.concat #js [(js/Buffer.from #js [0x01 code 0x12 0x20]) digest])))))

(defn hashes-to?
  "Do `buf`'s bytes hash to the digest named by `cid`?"
  [cid buf]
  (when-let [{:keys [digest]} (parse-cid cid)]
    (.equals digest (-> (.createHash nc "sha256") (.update buf) (.digest)))))
(def default-max-block-bytes (* 16 1024 1024))

;; ── signature ───────────────────────────────────────────────────────────────

(defn signed-message [method cid time]
  (str domain-tag method "\n" cid "\n" time))

(defn- spki [pub]
  (.createPublicKey nc #js {:key (js/Buffer.concat #js [(js/Buffer.from #js [0x30 0x2a 0x30 0x05 0x06 0x03 0x2b 0x65 0x70 0x03 0x21 0x00]) pub])
                            :format "der" :type "spki"}))

(defn authorize
  "nil when the request is signed by an allowed key within the skew window,
   else [status reason]."
  [{:keys [allow max-skew]} method cid headers now]
  (let [signer (get headers "x-kotoba-signer")
        time-s (get headers "x-kotoba-time")
        sig (get headers "x-kotoba-signature")
        t (when (and (string? time-s) (re-matches #"[0-9]{1,12}" time-s)) (js/parseInt time-s 10))]
    (cond
      (not (and signer time-s sig)) [401 "signature required"]
      (not (contains? allow signer)) [403 "signer is not allowed"]
      (or (nil? t) (> (js/Math.abs (- now t)) max-skew)) [401 "signature time outside the allowed skew"]
      :else
      (let [ok (try (.verify nc nil (js/Buffer.from (signed-message method cid time-s) "utf8")
                             (spki (g/ed25519-pub-of-did signer))
                             (js/Buffer.from sig "base64url"))
                    (catch :default _ false))]
        (when-not ok [401 "signature does not verify"])))))

;; ── the store ───────────────────────────────────────────────────────────────

(defn hold-path [signer cid] (str "/block-ingest/" (subs signer 8) "/" cid))

(defn- run [bin env args stdin]
  (js/Promise.
   (fn [resolve]
     (let [child (.spawn cp bin (clj->js args) #js {:env env})
           out #js [] err #js []]
       (.on (.-stdout child) "data" #(.push out %))
       (.on (.-stderr child) "data" #(.push err %))
       (.on child "error" (fn [e] (resolve {:code -1 :out (js/Buffer.alloc 0) :err (str e)})))
       (.on child "close" (fn [code] (resolve {:code code :out (js/Buffer.concat out)
                                               :err (str (js/Buffer.concat err))})))
       (if stdin (.end (.-stdin child) stdin) (.end (.-stdin child)))))))

(def fs (js/require "node:fs"))
(def path-mod (js/require "node:path"))

(defn- unixfs? [cid] (= "raw" (:codec (parse-cid cid))))

(defn- path-parts
  "/block-ingest/<suffix>/<cid> -> [suffix cid]."
  [p]
  (let [[_ suffix cid] (re-matches #"/block-ingest/([^/]+)/([^/]+)" p)] [suffix cid]))

(defn file-holds
  "Non-UnixFS holds as one JSON array of CIDs per signer under `state-dir`."
  [state-dir]
  (let [file #(.join path-mod state-dir "holds" (str % ".json"))
        read-set (fn [suffix] (set (try (g/parse-json (.readFileSync fs (file suffix) "utf8")) (catch :default _ []))))
        write! (fn [suffix cids]
                 (let [f (file suffix) tmp (str f ".tmp")]
                   (.mkdirSync fs (.dirname path-mod f) #js {:recursive true})
                   (.writeFileSync fs tmp (g/canonical-str (vec (sort cids))))
                   (.renameSync fs tmp f)))]
    {:held? (fn [suffix cid] (contains? (read-set suffix) cid))
     :add! (fn [suffix cid] (write! suffix (conj (read-set suffix) cid)))
     :remove! (fn [suffix cid] (write! suffix (disj (read-set suffix) cid)))
     :list (fn [suffix] (read-set suffix))
     :held-by-anyone? (fn [cid]
                        (let [dir (.join path-mod state-dir "holds")]
                          (boolean (some (fn [f] (and (str/ends-with? f ".json")
                                                      (contains? (read-set (subs f 0 (- (count f) 5))) cid)))
                                         (try (array-seq (.readdirSync fs dir)) (catch :default _ []))))))}))

(defn file-heads
  "Heads kept as one JSON file per signer under `state-dir`:
   {:head (fn [suffix name]) :heads (fn [suffix]) :put-head! (fn [suffix name rec])}."
  [state-dir]
  (let [file #(.join path-mod state-dir "heads" (str % ".json"))
        read-all (fn [suffix] (try (g/parse-json (.readFileSync fs (file suffix) "utf8")) (catch :default _ {})))]
    {:heads (fn [suffix] (js/Promise.resolve (read-all suffix)))
     :head (fn [suffix name] (js/Promise.resolve (get (read-all suffix) name)))
     :put-head! (fn [suffix name rec]
                  (let [f (file suffix) tmp (str f ".tmp")]
                    (.mkdirSync fs (.dirname path-mod f) #js {:recursive true})
                    (.writeFileSync fs tmp (g/canonical-str (assoc (read-all suffix) name rec)))
                    (.renameSync fs tmp f)
                    (js/Promise.resolve nil)))}))

(defn kubo-store
  "The store over a Kubo CLI: put the block, hold it (MFS for raw, a direct
   pin + `file-holds` for dag-cbor), release, read offline, list a signer's
   holds; heads live in `state-dir`. Every function returns a Promise."
  [ipfs-bin ipfs-path & [state-dir]]
  (let [env (doto (js/Object.assign #js {} (aget js/process "env")) (aset "IPFS_PATH" ipfs-path))
        ipfs (fn [args & [stdin]] (run ipfs-bin env args stdin))
        pins (file-holds (or state-dir "."))
        pin! (fn [cid]
               (.then (ipfs ["pin" "add" "--recursive=false" cid])
                      (fn [{:keys [code err]}]
                        (when-not (zero? code) (throw (g/unmeasured (str "pin add: " (str/trim err))))))))
        mfs-hold! (fn [p cid]
                    (-> (ipfs ["files" "mkdir" "-p" (subs p 0 (str/last-index-of p "/"))])
                        (.then (fn [_] (ipfs ["files" "cp" (str "/ipfs/" cid) p])))
                        (.then (fn [{:keys [code err]}]
                                 (when-not (or (zero? code) (str/includes? err "already has entry"))
                                   (throw (g/unmeasured (str "files cp: " (str/trim err)))))))))
        hold! (fn [p]
                (let [[suffix cid] (path-parts p)]
                  (if (unixfs? cid)
                    (mfs-hold! p cid)
                    (.then (pin! cid) (fn [_] ((:add! pins) suffix cid))))))]
    (merge
    {:put! (fn [codec buf]
             (-> (ipfs ["block" "put" (str "--cid-codec=" codec) "--mhtype=sha2-256" "--allow-big-block"] buf)
                 (.then (fn [{:keys [code out err]}]
                          (if (zero? code) (str/trim (str out)) (throw (g/unmeasured (str "block put: " (str/trim err)))))))))
     :held? (fn [p]
              (let [[suffix cid] (path-parts p)]
                (if (unixfs? cid)
                  (.then (ipfs ["files" "stat" "--hash" p]) #(zero? (:code %)))
                  (js/Promise.resolve ((:held? pins) suffix cid)))))
     :hold! hold!
     :release! (fn [p]
                 (let [[suffix cid] (path-parts p)]
                   (if (unixfs? cid)
                     (.then (ipfs ["files" "rm" p]) #(zero? (:code %)))
                     (do ((:remove! pins) suffix cid)
                         (if ((:held-by-anyone? pins) cid)
                           (js/Promise.resolve true)
                           (.then (ipfs ["pin" "rm" cid]) (fn [_] true)))))))
     :get (fn [cid] (.then (ipfs ["block" "get" "--offline" cid]) #(when (zero? (:code %)) (:out %))))
     :holds (fn [suffix]
              (.then (ipfs ["files" "ls" (str "/block-ingest/" suffix)])
                     (fn [{:keys [code out]}]
                       (vec (sort (into ((:list pins) suffix)
                                        (when (zero? code)
                                          (filter #(re-matches raw-cid-re %) (str/split-lines (str out))))))))))
     ;; mirror helpers: hold a block that is (or will be, via bitswap) in Kubo
     :hold-remote! (fn [p cid timeout-s]
                     (-> (ipfs ["block" "stat" (str "--timeout=" timeout-s "s") cid])
                         (.then (fn [{:keys [code err]}]
                                  (when-not (zero? code) (throw (g/unmeasured (str "fetch " cid ": " (str/trim err)))))
                                  (hold! p)))))}
    (when state-dir (file-heads state-dir)))))

;; ── requests ────────────────────────────────────────────────────────────────

(defn- json [status body] {:status status :json body})

(defn handle
  "One request -> Promise<{:status, :json | :bytes}>. `req` is
   {:method :path :headers :body (Buffer, for PUT)}; `store` is `kubo-store`
   or a stand-in."
  [opts store now {:keys [method path headers body]}]
  (let [[_ cid] (re-matches #"/v1/blocks/(.+)" path)]
    (cond
      (and (= method "GET") (= path "/health")) (js/Promise.resolve (json 200 {"ok" true}))
      (nil? cid) (js/Promise.resolve (json 404 {"refused" "not found"}))
      (not (parse-cid cid)) (js/Promise.resolve (json 400 {"refused" "not a CIDv1 sha2-256 with codec raw or dag-cbor"}))

      (= method "GET")
      (.then ((:get store) cid)
             (fn [buf]
               (cond
                 (nil? buf) (json 404 {"refused" "block is not held here"})
                 (not (hashes-to? cid buf)) (json 500 {"unmeasured" "stored bytes do not hash to the CID"})
                 :else {:status 200 :bytes buf :cid cid})))

      (#{"PUT" "DELETE"} method)
      (if-let [[status reason] (authorize opts method cid headers now)]
        (js/Promise.resolve (json status {"refused" reason}))
        (let [signer (get headers "x-kotoba-signer") p (hold-path signer cid)]
          (if (= method "DELETE")
            (.then ((:held? store) p)
                   (fn [held]
                     (if-not held
                       (json 404 {"refused" "not held by this signer"})
                       (.then ((:release! store) p) (fn [_] (json 200 {"released" cid}))))))
            (cond
              (nil? body) (js/Promise.resolve (json 400 {"refused" "body required"}))
              (> (.-length body) (:max-block-bytes opts)) (js/Promise.resolve (json 413 {"refused" "block too large"}))
              (not (hashes-to? cid body)) (js/Promise.resolve (json 400 {"refused" "bytes do not hash to the CID"}))
              :else
              (-> ((:held? store) p)
                  (.then (fn [already]
                           (if already
                             (json 200 {"cid" cid "size" (.-length body) "held" p})
                             (-> ((:put! store) (:codec (parse-cid cid)) body)
                                 (.then (fn [got]
                                          (when-not (= got cid) (throw (g/unmeasured (str "Kubo stored " got " for " cid))))
                                          ((:hold! store) p)))
                                 (.then (fn [_] (json 201 {"cid" cid "size" (.-length body) "held" p}))))))))))))

      :else (js/Promise.resolve (json 405 {"refused" "method not allowed"})))))

;; ── rate limit ──────────────────────────────────────────────────────────────
;; Served directly on a router port (UPnP) rather than behind nginx, so the
;; per-address limit nginx gave the writer lives here: a token bucket of
;; --burst requests refilled at --rate per second, per remote address.

(defn limiter [rate burst]
  (let [buckets (atom {})]
    (fn [addr now-ms]
      (let [{:keys [tokens at]} (get @buckets addr {:tokens burst :at now-ms})
            tokens (min burst (+ tokens (* rate (/ (- now-ms at) 1000))))
            ok (>= tokens 1)]
        (when (> (count @buckets) 10000) (reset! buckets {}))
        (swap! buckets assoc addr {:tokens (if ok (dec tokens) tokens) :at now-ms})
        ok))))

;; ── heads and holds ─────────────────────────────────────────────────────────
;; A head is a signer's mutable name for one of its own held blocks -- what R2
;; keys like `statement` were. PUT carries {"cid", "seq"} and is signed with the
;; cid slot "head/<name>/<seq>/<cid>"; seq must grow, and the block must be held
;; by the same signer, so a head never points at bytes the fleet lacks and can
;; never be rolled back. GETs are public. /v1/holds/<signer> lists the CIDs a
;; signer holds (ciphertext addresses; what block_mirror.cljk copies).

(def head-name-re #"[a-z0-9][a-z0-9._-]{0,63}")
(def signer-suffix-re #"z6Mk[1-9A-HJ-NP-Za-km-z]{40,60}")

(defn- head-message-slot [name seq cid] (str "head/" name "/" seq "/" cid))

(defn handle-heads
  "nil when `path` is not a heads/holds route, else Promise<response>."
  [opts store now {:keys [method path headers body]}]
  (let [holds (re-matches #"/v1/holds/([^/]+)" path)
        heads (re-matches #"/v1/heads/([^/]+)" path)
        head (re-matches #"/v1/heads/([^/]+)/([^/]+)" path)]
    (cond
      (and holds (= method "GET"))
      (let [suffix (second holds)]
        (if-not (re-matches signer-suffix-re suffix)
          (js/Promise.resolve (json 400 {"refused" "not a did:key suffix"}))
          (.then ((:holds store) suffix) #(json 200 {"signer" (str "did:key:" suffix) "cids" %}))))

      (and head (= method "GET"))
      (let [[_ suffix name] head]
        (if-not (and (re-matches signer-suffix-re suffix) (re-matches head-name-re name))
          (js/Promise.resolve (json 400 {"refused" "bad signer or head name"}))
          (.then ((:head store) suffix name) #(if % (json 200 %) (json 404 {"refused" "no such head"})))))

      (and heads (= method "GET") (re-matches signer-suffix-re (second heads)))
      (.then ((:heads store) (second heads)) #(json 200 {"signer" (str "did:key:" (second heads)) "heads" %}))

      (and heads (= method "PUT"))
      (let [name (second heads)
            rec (try (g/parse-json (str body)) (catch :default _ nil))
            cid (get rec "cid") seq (get rec "seq")]
        (cond
          (not (re-matches head-name-re name)) (js/Promise.resolve (json 400 {"refused" "bad head name"}))
          (not (and (parse-cid cid) (js/Number.isInteger seq) (pos? seq)))
          (js/Promise.resolve (json 400 {"refused" "body must be {\"cid\": raw or dag-cbor cid, \"seq\": positive integer}"}))
          :else
          (if-let [[status reason] (authorize opts "PUT" (head-message-slot name seq cid) headers now)]
            (js/Promise.resolve (json status {"refused" reason}))
            (let [signer (get headers "x-kotoba-signer") suffix (subs signer 8)]
              (-> (js/Promise.all #js [((:held? store) (hold-path signer cid)) ((:head store) suffix name)])
                  (.then (fn [[held current]]
                           (cond
                             (not held) (json 409 {"refused" "the head must name a block this signer holds"})
                             (and current (<= seq (get current "seq"))) (json 409 {"refused" "seq must grow" "current" current})
                             :else (let [r {"cid" cid "seq" seq "at" now}]
                                     (.then ((:put-head! store) suffix name r) (fn [_] (json 200 r))))))))))))

      :else nil)))

;; ── server ──────────────────────────────────────────────────────────────────

(defn- headers-of [^js req]
  (into {} (map (fn [k] [k (aget (.-headers req) k)]) ["x-kotoba-signer" "x-kotoba-time" "x-kotoba-signature"])))

(defn- read-body
  "Promise<Buffer|:too-large>. Stops reading past `limit` bytes."
  [^js req limit]
  (js/Promise.
   (fn [resolve]
     (let [chunks #js [] n (atom 0) over (atom false)]
       (.on req "data" (fn [c] (swap! n + (.-length c))
                         (if (> @n limit) (when-not @over (reset! over true) (resolve :too-large) (.pause req))
                             (.push chunks c))))
       (.on req "end" #(when-not @over (resolve (js/Buffer.concat chunks))))
       (.on req "error" #(resolve nil))))))

(defn- reply [^js res {:keys [status json bytes cid]}]
  (if bytes
    (do (.writeHead res status #js {"content-type" (if (= "dag-cbor" (:codec (parse-cid cid)))
                                                      "application/vnd.ipld.dag-cbor" "application/vnd.ipld.raw") "content-length" (.-length bytes)
                                    "cache-control" "public, max-age=31536000, immutable"})
        (.end res bytes))
    (let [s (g/canonical-str json)]
      (.writeHead res status #js {"content-type" "application/json"})
      (.end res s))))

(defn serve! [opts store]
  (let [inflight (atom 0)
        allow? (limiter (:rate opts) (:burst opts))]
    (let [server
     (.createServer
      http
      (fn [^js req ^js res]
        (let [method (.-method req)
              path (first (str/split (.-url req) #"\?"))
              addr (str (.. req -socket -remoteAddress))
              now (js/Math.floor (/ (js/Date.now) 1000))
              go (fn [body]
                   (-> (let [r {:method method :path path :headers (headers-of req) :body body}]
                         (or (handle-heads opts store now r) (handle opts store now r)))
                       (.catch (fn [e] {:status (if (= :unmeasured (g/kind e)) 503 500) :json {"unmeasured" (g/message e)}}))
                       (.then #(reply res %))))]
          (cond
            (not (allow? addr (js/Date.now)))
            (reply res {:status 429 :json {"refused" "rate limited"}})
            (= method "PUT")
            (if (>= @inflight (:max-concurrent-puts opts))
              (reply res {:status 503 :json {"unmeasured" "too many concurrent writes"}})
              (do (swap! inflight inc)
                  (-> (read-body req (:max-block-bytes opts))
                      (.then (fn [b] (if (= b :too-large) (reply res {:status 413 :json {"refused" "block too large"}}) (go b))))
                      (.finally #(swap! inflight dec)))))
            :else (go nil)))))]
      ;; Node closes idle keep-alive sockets after 5 s by default; a client that
      ;; reuses one at that moment gets ECONNRESET ("fetch failed"), seen twice
      ;; on 2026-10-07 (mirror listing, prober head). Keep them past any
      ;; client's reuse window.
      (set! (.-keepAliveTimeout server) 65000)
      (set! (.-headersTimeout server) 66000)
      (.listen server (:port opts) (:host opts)))))

(defn- flags [k] (keep #(when (str/starts-with? % (str k "=")) (subs % (inc (count k)))) (array-seq (aget js/process "argv"))))

(defn main []
  (let [one #(first (flags %))
        opts {:allow (set (flags "--allow"))
              :host (or (one "--host") "127.0.0.1")
              :port (js/parseInt (or (one "--port") "18140") 10)
              :max-block-bytes (js/parseInt (or (one "--max-block-bytes") (str default-max-block-bytes)) 10)
              :max-skew (js/parseInt (or (one "--max-skew") "300") 10)
              :max-concurrent-puts (js/parseInt (or (one "--max-concurrent-puts") "4") 10)
              :rate (js/parseFloat (or (one "--rate") "20"))
              :burst (js/parseFloat (or (one "--burst") "40"))}]
    (when (empty? (:allow opts)) (println "REFUSED: at least one --allow=did:key:... is required") (js/process.exit 2))
    (doseq [d (:allow opts)] (g/ed25519-pub-of-did d))
    (serve! opts (kubo-store (one "--ipfs-bin") (one "--ipfs-path") (or (one "--state-dir") ".")))
    (println (str "block-ingest on " (:host opts) ":" (:port opts) ", " (count (:allow opts)) " signer(s)"))))

(when (some #(str/ends-with? % "block_ingest.cljk") (array-seq (aget js/process "argv")))
  (main))
