[Unit]
Description=Refresh the Yataverse IPNS name from gad
After=network-online.target

[Service]
Type=oneshot
Environment=IPFS_PATH=/home/gad/.ipfs
Environment=IPFS_TELEMETRY=off
ExecStart=/home/gad/.local/bin/yataverse-ipns-refresh /usr/local/bin/ipfs /home/gad/.local/share/yataverse/current-cid k51qzi5uqu5dlrtqhevrfpyrdr2c1thxug3iqys76xxbi7bgzm16mjti2bwrf2
TimeoutStartSec=180
MemoryMax=256M
CPUQuota=50%
